---
/* Projects as live architecture. Tabs sit right above the diagram, so
   picking a project and watching its architecture are never a scroll apart.
   Each switch "provisions" the diagram: services come up one by one, then
   traffic flows along the real request path. The tabs advance on their own
   until the visitor takes over. Without JavaScript the first project shows,
   and every case study is still a link. */
import type { Project } from '../data/projects';
import { architectures, type ArchNode } from '../data/architectures';
import SocialIcon from './SocialIcon.astro';
import { archIcon } from '../lib/archIcons';

interface Props {
  projects: Project[];
  /** One diagram on its own, with no tabs or project card (case study pages). */
  compact?: boolean;
}
const items = Astro.props.projects.filter((p) => architectures[p.slug]);
const compact = Astro.props.compact ?? false;

const W = 800;
const H = 400;
const TW = 400;
// Icon half size, and how far the label reaches below the icon centre.
const HALF = 26;
const BELOW = 50;

type Pt = { x: number; y: number };
const at = (n: ArchNode, tall: boolean): Pt => (tall ? { x: n.tx, y: n.ty } : { x: n.x, y: n.y });

// Trim an edge so it starts and ends at the edge of each icon, and clear of
// the label when it leaves or arrives from below. Labels are about 4 units
// per character either side of the centre.
function trim(a: ArchNode, b: ArchNode, tall: boolean) {
  const p = at(a, tall);
  const q = at(b, tall);
  const dx = q.x - p.x;
  const dy = q.y - p.y;
  const cut = (n: ArchNode, below: boolean) => {
    const hw = below ? Math.max(HALF, n.label.length * 4 + 6) : HALF + 4;
    const tx = dx === 0 ? Infinity : hw / Math.abs(dx);
    const ty = dy === 0 ? Infinity : (below ? BELOW : HALF + 4) / Math.abs(dy);
    return Math.min(tx, ty);
  };
  const ta = cut(a, dy > 0);
  const tb = 1 - cut(b, dy < 0);
  return { x1: p.x + dx * ta, y1: p.y + dy * ta, x2: p.x + dx * tb, y2: p.y + dy * tb };
}
---

<div class:list={['arch', { 'arch--compact': compact }]} data-arch>
  <div class="arch__tabs" role="tablist" aria-label="Projects" hidden={compact}>
    {
      items.map((p, i) => (
        <button
          type="button"
          role="tab"
          class="arch__tab"
          id={`arch-tab-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`arch-panel-${i}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          {architectures[p.slug].short}
          <span class="arch__timer" aria-hidden="true" />
        </button>
      ))
    }
  </div>

  {!compact && (
    <div class="arch__step" data-stepper>
      <button type="button" data-step="-1" aria-label="Previous project">
        <SocialIcon name="arrow" size={16} />
      </button>
      <p aria-live="polite">
        <b data-step-name>{architectures[items[0].slug].short}</b>
        <span data-step-count>1 of {items.length}</span>
      </p>
      <button type="button" data-step="1" aria-label="Next project">
        <SocialIcon name="arrow" size={16} />
      </button>
    </div>
  )}

  {
    items.map((p, i) => {
      const a = architectures[p.slug];
      const byId = Object.fromEntries(a.nodes.map((n) => [n.id, n]));
      return (
        <div class="arch__panel" role="tabpanel" id={`arch-panel-${i}`} aria-labelledby={`arch-tab-${i}`} hidden={i !== 0} data-panel={i}>
          <div class="arch__board">
            <span class="arch__status" data-status>
              <i aria-hidden="true" />
              <span>Healthy</span>
            </span>
            {[false, true].map((tall) => (
              <svg
                class={tall ? 'arch__svg arch__svg--tall' : 'arch__svg arch__svg--wide'}
                viewBox={tall ? `0 0 ${TW} ${a.tallH}` : `0 0 ${W} ${H}`}
                role="img"
                aria-label={`Request flow for ${p.title}: ${a.nodes.map((n) => n.label).join(', ')}`}
              >
                <defs>
                  <marker id={`arrow-${i}-${tall ? 't' : 'w'}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" class="arch__arrowhead" />
                  </marker>
                </defs>
                <g class="arch__edges">
                  {a.edges.map(([from, to], k) => (
                    <line {...trim(byId[from], byId[to], tall)} style={`--k:${k}`} marker-end={`url(#arrow-${i}-${tall ? 't' : 'w'})`} data-edge={k} />
                  ))}
                </g>
                <g class="arch__nodes">
                  {a.nodes.map((n, k) => {
                    const pt = at(n, tall);
                    return (
                      <g class:list={['arch__node', { 'arch__node--actor': n.actor }]} transform={`translate(${pt.x},${pt.y})`}>
                        <g class="arch__pop" style={`--k:${k}`}>
                          <g class="arch__icon" set:html={archIcon(n.icon, 48)} />
                          <text y={HALF + 17}>{n.label}</text>
                        </g>
                      </g>
                    );
                  })}
                </g>
                <g class="arch__packets" data-packets />
              </svg>
            ))}
          </div>

          {!compact && <div class="arch__card">
            <p class="arch__meta">
              {p.date} · {p.context}
            </p>
            <h3 class="arch__title">{p.title}</h3>
            <p class="arch__summary">{p.summary}</p>
            {p.result?.[0] && (
              <p class="arch__outcome">
                <span>Outcome</span>
                {p.result[0]}
              </p>
            )}
            <div class="arch__links">
              <a class="btn btn--primary" href={`/projects/${p.slug}`}>
                Case study
                <SocialIcon name="arrow" size={15} />
              </a>
              {p.repo && (
                <a class="btn btn--ghost" href={p.repo} target="_blank" rel="noopener">
                  <SocialIcon name="github" size={15} />
                  Code
                </a>
              )}
              {p.video && (
                <a class="btn btn--ghost" href={p.video} target="_blank" rel="noopener">
                  <SocialIcon name="youtube" size={15} />
                  Video
                </a>
              )}
            </div>
          </div>}
        </div>
      );
    })
  }
</div>

<style>
  .arch__tabs {
    position: relative;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
    margin-bottom: 1.25rem;
    justify-content: safe center;
  }
  /* Phones swap the tab strip for one row: previous, the project, next. */
  .arch__step {
    display: none;
  }
  @media (max-width: 640px) {
    .arch.has-js .arch__tabs {
      display: none;
    }
    .arch.has-js .arch__step {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.9rem;
    }
  }
  .arch__step p {
    flex: 1;
    margin: 0;
    text-align: center;
    line-height: 1.25;
  }
  .arch__step b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  .arch__step span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }
  .arch__step button {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1px solid var(--highlight);
    background: var(--highlight);
    color: var(--brand-deep);
    cursor: pointer;
  }
  .arch__step button[data-step='-1'] :global(svg) {
    transform: scaleX(-1);
  }
  /* Every project stays visible: the strip wraps instead of hiding tabs off screen. */
  .arch__tabs {
    flex-wrap: wrap;
    justify-content: center;
    overflow: visible;
  }
  @media (max-width: 640px) {
    .arch__tabs {
      gap: 0.35rem;
      margin-bottom: 0.9rem;
    }
    .arch__tab {
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      padding: 0.5rem 0.75rem;
    }
  }
  .arch__tabs::-webkit-scrollbar {
    display: none;
  }
  .arch__tab {
    position: relative;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    padding: 0.7rem 1.1rem;
    cursor: pointer;
    overflow: hidden;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .arch__tab:hover {
    color: var(--text);
    border-color: var(--accent-line);
  }
  .arch__tab[aria-selected='true'] {
    background: var(--highlight);
    border-color: var(--highlight);
    color: var(--brand-deep);
  }
  /* A thin bar fills under the active tab while it waits to advance. */
  .arch__timer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--brand-deep);
    opacity: 0.4;
  }
  .arch.is-auto .arch__tab[aria-selected='true'] .arch__timer {
    animation: arch-timer var(--arch-dwell, 8s) linear forwards;
  }
  @keyframes arch-timer {
    to {
      width: 100%;
    }
  }

  .arch__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .arch__panel[hidden] {
    display: none;
  }
  .arch--compact .arch__panel {
    grid-template-columns: minmax(0, 1fr);
  }
  .arch__tabs[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .arch__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .arch__board {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    padding: clamp(0.5rem, 2vw, 1.25rem);
  }
  .arch__board > svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .arch__svg--tall {
    display: none !important;
  }
  @media (max-width: 640px) {
    .arch__svg--wide {
      display: none !important;
    }
    .arch__svg--tall {
      display: block !important;
      max-width: 22rem;
      margin: 1.5rem auto 0;
    }
  }
  .arch__status {
    position: absolute;
    top: 0.75rem;
    left: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .arch__status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6a9ad6;
  }
  .arch__status.is-provisioning i {
    background: var(--highlight);
    animation: arch-blink 0.5s steps(2) infinite;
  }
  @keyframes arch-blink {
    50% {
      opacity: 0.2;
    }
  }

  .arch__edges line {
    stroke: var(--text-muted);
    stroke-width: 1.6;
    opacity: 0.75;
  }
  .arch__arrowhead {
    fill: var(--text-muted);
  }
  .arch :global(.arch__ring) {
    fill: var(--bg);
    stroke: var(--highlight);
    stroke-width: 2;
  }
  .arch__node--actor .arch__icon {
    color: var(--text);
  }
  .arch__node text {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
    stroke-linejoin: round;
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text);
    text-anchor: middle;
    dominant-baseline: middle;
  }
  .arch__svg--tall .arch__node text {
    font-size: 14px;
  }
  .arch :global(.arch__pk) {
    fill: var(--highlight);
  }

  /* Provisioning: each service comes up in place, then its links fade in. The
     animation runs on an inner group, so a node never travels across the
     board on its way to its own position. */
  .arch__pop {
    transform-box: fill-box;
    transform-origin: center;
  }
  .arch__panel.is-provisioning .arch__pop {
    animation: arch-up 0.45s var(--ease-out) both;
    animation-delay: calc(var(--k) * 110ms);
  }
  .arch__panel.is-provisioning .arch__edges line {
    animation: arch-link 0.5s ease-out both;
    animation-delay: calc(400ms + var(--k) * 110ms);
  }
  @keyframes arch-up {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @keyframes arch-link {
    from {
      opacity: 0;
    }
  }

  .arch__meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .arch__title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 0.6rem;
  }
  .arch__summary {
    color: var(--text-muted);
  }
  .arch__outcome {
    border-left: 2px solid var(--highlight);
    padding-left: 0.9rem;
    font-size: 0.95rem;
  }
  .arch__outcome span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }
  .arch__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 900px) {
    .arch__card {
      text-align: center;
    }
    .arch__card p {
      margin-inline: auto;
    }
    .arch__outcome {
      border-left: 0;
      padding-left: 0;
      border-top: 2px solid var(--highlight);
      padding-top: 0.7rem;
    }
    .arch__links {
      justify-content: center;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch]');
  if (root) {
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const DWELL = 8000;
    let current = 0;
    let auto = !reduce && panels.length > 1;
    let timer = 0;

    // Packets: two per link, travelling in the order traffic flows.
    type Packet = { el: SVGCircleElement; line: SVGLineElement; offset: number };
    // Each panel has a wide and a tall drawing; packets run in whichever is shown.
    const packets: Packet[][] = panels.map((panel) =>
      [...panel.querySelectorAll<SVGSVGElement>('svg.arch__svg')].flatMap((svg) => {
        const group = svg.querySelector<SVGGElement>('[data-packets]')!;
        return [...svg.querySelectorAll<SVGLineElement>('[data-edge]')].flatMap((line, k) =>
          [0, 0.5].map((o) => {
            const el = document.createElementNS(NS, 'circle');
            el.setAttribute('r', '4.5');
            el.setAttribute('class', 'arch__pk');
            group.appendChild(el);
            return { el, line, offset: o + k * 0.17 };
          })
        );
      })
    );
    let shownAt = performance.now();
    root.classList.add('has-js');
    const stepName = root.querySelector<HTMLElement>('[data-step-name]');
    const stepCount = root.querySelector<HTMLElement>('[data-step-count]');
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        takeOver();
        show(current + Number(b.dataset.step));
      })
    );

    const show = (i: number, focus = false) => {
      current = (i + panels.length) % panels.length;
      tabs.forEach((t, k) => {
        const on = k === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, k) => (p.hidden = k !== current));
      const panel = panels[current];
      const status = panel.querySelector<HTMLElement>('[data-status]');
      if (!reduce) {
        panel.classList.remove('is-provisioning');
        void panel.offsetWidth;
        panel.classList.add('is-provisioning');
        status?.classList.add('is-provisioning');
        if (status) status.lastElementChild!.textContent = 'Provisioning';
        window.setTimeout(() => {
          status?.classList.remove('is-provisioning');
          if (status) status.lastElementChild!.textContent = 'Healthy';
        }, 1300);
      }
      shownAt = performance.now();
      if (stepName) stepName.textContent = tabs[current].textContent!.trim();
      if (stepCount) stepCount.textContent = `${current + 1} of ${panels.length}`;
      // Scroll only the tab strip sideways, never the page.
      const strip = tabs[current].parentElement!;
      strip.scrollTo({
        left: tabs[current].offsetLeft - strip.clientWidth / 2 + tabs[current].offsetWidth / 2,
        behavior: reduce ? 'auto' : 'smooth',
      });
      if (focus) tabs[current].focus();
      schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      root.classList.toggle('is-auto', auto);
      root.style.setProperty('--arch-dwell', `${DWELL}ms`);
      if (auto) timer = window.setTimeout(() => show(current + 1), DWELL);
    };

    const takeOver = () => {
      auto = false;
      schedule();
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        takeOver();
        show(i);
      })
    );
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      e.preventDefault();
      takeOver();
      show(current + (key === 'ArrowRight' ? 1 : -1), true);
    });
    root.addEventListener('pointerdown', takeOver);

    // Only auto-advance while the section is on screen.
    // A single diagram provisions once, when it first scrolls into view.
    if (panels.length === 1 && !reduce && 'IntersectionObserver' in window) {
      const once = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        once.disconnect();
        show(0);
      }, { threshold: 0.35 });
      once.observe(root);
    }

    if (auto && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        if (!auto) return;
        if (e.isIntersecting) show(current);
        else window.clearTimeout(timer);
      }, { threshold: 0.35 }).observe(root);
    }

    const tick = (now: number) => {
      const list = packets[current];
      const since = (now - shownAt) / 1000;
      const live = reduce || since > 1.1;
      for (const p of list) {
        if (!live) {
          p.el.style.opacity = '0';
          continue;
        }
        const f = (((now / 1000) * 0.55 + p.offset) % 1 + 1) % 1;
        const x1 = +p.line.getAttribute('x1')!, y1 = +p.line.getAttribute('y1')!;
        const x2 = +p.line.getAttribute('x2')!, y2 = +p.line.getAttribute('y2')!;
        p.el.setAttribute('cx', String(x1 + (x2 - x1) * f));
        p.el.setAttribute('cy', String(y1 + (y2 - y1) * f));
        p.el.style.opacity = String(Math.min(1, Math.sin(f * Math.PI) * 2));
      }
      if (!reduce) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

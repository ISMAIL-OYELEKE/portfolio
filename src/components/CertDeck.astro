---
/* All certifications and badges as one deck of cards. They start stacked;
   "Deal the deck" lays them out, and each card flips to show the issuer,
   the dates and the verify link. Without JavaScript the cards are simply a
   grid, already dealt, with the back details visible on the front. */
import { Image } from 'astro:assets';
import { headlineCerts, badgeGroups } from '../data/certifications';

const cards = [
  ...headlineCerts.map((c) => ({ ...c, major: true })),
  ...badgeGroups.flatMap((g) => g.badges.map((c) => ({ ...c, major: false }))),
];
---

<div class="deck-wrap">
  <p id="dcard-hint" class="visually-hidden">Flip for details</p>
  <div class="deck" data-deck>
    {
      cards.map((c, i) => (
        <div class:list={['dcard', { 'dcard--major': c.major }]} tabindex="0" role="button" aria-describedby="dcard-hint">
          <div class="dcard__in">
            <div class="dcard__face dcard__front">
              <span class="dcard__issuer">{c.issuer}</span>
              {c.image && (
                <Image
                  class:list={['dcard__art', { 'dcard__art--wide': c.imageShape === 'certificate' }]}
                  src={c.image}
                  alt={`${c.name} badge`}
                  width={c.imageShape === 'certificate' ? 140 : 84}
                  densities={[1, 2]}
                  format="webp"
                  loading="lazy"
                />
              )}
              <span class="dcard__name">{c.name}</span>
            </div>
            <div class="dcard__face dcard__back">
              <span class="dcard__kind">
                {c.major ? 'Certification' : 'Badge'} · {String(i + 1).padStart(2, '0')} of {cards.length}
              </span>
              <span class="dcard__who">{c.issuer}</span>
              <span class="dcard__dates">
                {c.issued && <span>Issued {c.issued}</span>}
                {c.expires && <span>Valid to {c.expires}</span>}
              </span>
              <a href={c.verify} target="_blank" rel="noopener" tabindex="-1">Verify</a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="deck-actions">
    <button type="button" class="btn btn--primary" data-deal hidden>Deal the deck</button>
    <slot />
  </div>
</div>

<style>
  .deck-wrap {
    text-align: center;
  }
  .deck {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 14px;
    text-align: left;
  }
  .deck.is-live {
    display: block;
    position: relative;
    height: 320px;
    transition: height 0.7s var(--ease-out);
  }
  .dcard {
    height: 236px;
    perspective: 900px;
    cursor: pointer;
    outline-offset: 4px;
  }
  .deck.is-live .dcard {
    position: absolute;
    left: 0;
    top: 0;
    width: 170px;
    transform-origin: top left;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .dcard__in {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
  }
  .dcard.is-flipped .dcard__in {
    transform: rotateY(180deg);
  }
  .dcard__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: var(--r-card);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .dcard__front {
    background: var(--brand-deep);
    color: var(--paper);
    border: 1px solid var(--brand-line);
  }
  .dcard--major .dcard__front {
    border-color: var(--highlight);
  }
  .dcard__issuer,
  .dcard__kind {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--highlight);
  }
  .dcard__art {
    width: 84px;
    height: 84px;
    object-fit: contain;
    margin: auto;
  }
  .dcard__art--wide {
    width: 140px;
    height: 84px;
  }
  .dcard__name {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: auto;
  }
  .dcard__back {
    background: var(--highlight);
    color: var(--brand-deep);
    transform: rotateY(180deg);
    justify-content: space-between;
  }
  .dcard__back .dcard__kind {
    color: var(--brand-deep);
  }
  .dcard__who {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
  }
  .dcard__dates {
    display: flex;
    flex-direction: column;
    font-size: 0.78rem;
  }
  .dcard__back a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  /* Without the script there is no flipping: show the back as a footer. */
  .deck:not(.is-live) .dcard {
    height: auto;
  }
  .deck:not(.is-live) .dcard__face {
    position: relative;
    transform: none;
  }
  .deck:not(.is-live) .dcard__front {
    min-height: 236px;
  }
  .deck:not(.is-live) .dcard__back {
    display: none;
  }
  .deck-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 1.4rem;
  }
  /* A dealt card that is flipped comes forward at full size, so its details
     stay readable even when the dealt grid is small enough to fit one screen. */
  .deck.is-live .dcard.is-flipped {
    z-index: 50 !important;
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const button = document.querySelector<HTMLButtonElement>('[data-deal]');
  if (deck && button) {
    const cards = [...deck.querySelectorAll<HTMLElement>('.dcard')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dealt = false;

    deck.classList.add('is-live');
    button.hidden = false;

    const section = deck.closest('section');
    const mast = () => document.querySelector('[data-masthead]')?.getBoundingClientRect().height ?? 73;
    // Bring the whole section (heading, cards and buttons) into one screen.
    const frame = () => {
      if (!section) return;
      const top = section.getBoundingClientRect().top + window.scrollY - mast();
      window.scrollTo({ top: Math.max(0, top), behavior: reduce ? 'auto' : 'smooth' });
    };
    let placed: { x: number; y: number; s: number }[] = [];

    const layout = () => {
      const w = deck.clientWidth, cw = 170, ch = 236;
      if (!dealt) {
        deck.style.height = '290px';
        cards.forEach((c, i) => {
          c.style.zIndex = String(cards.length - i);
          c.style.transitionDelay = '0ms';
          c.style.transform = `translate(${w / 2 - cw / 2 + ((i % 5) - 2) * 3}px, ${30 - i * 0.6}px) rotate(${((i % 7) - 3) * 2.2}deg)`;
        });
        return;
      }
      // Room left on screen for the cards once the heading and buttons are counted.
      const gap = w < 640 ? 8 : 12;
      const other = section ? section.offsetHeight - deck.offsetHeight - parseFloat(getComputedStyle(section).paddingBottom) : 320;
      const avail = Math.max(240, window.innerHeight - mast() - other);
      // Pick the column count that gives the biggest cards that still fit.
      let best = { cols: 2, scale: 0 };
      for (let cols = 2; cols <= 12; cols++) {
        const rows = Math.ceil(cards.length / cols);
        const s = Math.min(1, (w - (cols - 1) * gap) / (cols * cw), (avail - (rows - 1) * gap) / (rows * ch));
        if (s > best.scale) best = { cols, scale: s };
      }
      const { cols } = best;
      // Keep cards legible, but never wider than the deck.
      const scale = Math.min((w - (cols - 1) * gap) / (cols * cw), Math.max(0.36, best.scale));
      const sw = cw * scale, sh = ch * scale;
      const ox = (w - (cols * sw + (cols - 1) * gap)) / 2;
      placed = cards.map((_, i) => ({ x: ox + (i % cols) * (sw + gap), y: Math.floor(i / cols) * (sh + gap), s: scale }));
      cards.forEach((c, i) => {
        c.style.zIndex = '1';
        c.style.transitionDelay = reduce ? '0ms' : `${i * 20}ms`;
        place(c, i);
      });
      deck.style.height = `${Math.ceil(cards.length / cols) * (sh + gap) - gap}px`;
    };

    // A flipped card grows to full size, kept inside the deck's box.
    const place = (c: HTMLElement, i: number) => {
      const p = placed[i];
      if (!p) return;
      if (c.classList.contains('is-flipped') && p.s < 1) {
        const w = deck.clientWidth, h = deck.offsetHeight;
        const x = Math.min(Math.max(0, p.x - (170 - 170 * p.s) / 2), w - 170);
        const y = Math.min(Math.max(0, p.y - (236 - 236 * p.s) / 2), Math.max(0, h - 236));
        c.style.transitionDelay = '0ms';
        c.style.transform = `translate(${x}px, ${y}px) scale(1)`;
      } else {
        c.style.transform = `translate(${p.x}px, ${p.y}px) scale(${p.s})`;
      }
    };

    const setLinks = () =>
      cards.forEach((c) => {
        const link = c.querySelector('a');
        const open = dealt && c.classList.contains('is-flipped');
        if (link) link.tabIndex = open ? 0 : -1;
        // Only the face you can see is read out.
        c.querySelector('.dcard__back')?.setAttribute('aria-hidden', String(!open));
      });
    setLinks();

    cards.forEach((c) => {
      const flip = () => {
        if (!dealt) {
          dealt = true;
          button.textContent = 'Stack them back';
          layout();
          frame();
          return;
        }
        const open = !c.classList.contains('is-flipped');
        cards.forEach((o, j) => {
          if (o !== c && o.classList.contains('is-flipped')) {
            o.classList.remove('is-flipped');
            place(o, j);
          }
        });
        c.classList.toggle('is-flipped', open);
        place(c, cards.indexOf(c));
        setLinks();
      };
      c.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) return;
        flip();
      });
      c.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          flip();
        }
      });
    });

    button.addEventListener('click', () => {
      dealt = !dealt;
      button.textContent = dealt ? 'Stack them back' : 'Deal the deck';
      if (!dealt) cards.forEach((c) => c.classList.remove('is-flipped'));
      setLinks();
      layout();
      // Dealing or stacking changes the deck's height; keep the whole section,
      // from the count down to the buttons, on screen either way.
      frame();
    });

    layout();
    window.addEventListener('resize', layout);
  }
</script>

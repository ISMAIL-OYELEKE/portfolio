---
/**
 * Hand-drawn icon set on a 20px grid, square-cut rather than rounded,
 * so the marks sit with the rest of the type instead of looking borrowed.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  aria-hidden="true"
  focusable="false"
>
  {name === 'linkedin' && (
    <g>
      <rect x="2.2" y="2.2" width="15.6" height="15.6" />
      <path d="M6 8.3v6M6 5.4v.9" stroke-linecap="square" />
      <path d="M9.4 14.3v-6M9.4 10.4c0-1.2.9-2.1 2.2-2.1s2.2.9 2.2 2.4v3.6" />
    </g>
  )}
  {name === 'github' && (
    <g>
      <path d="M7.4 17.2v-2.5c-2.6.5-3.3-1.2-3.3-1.2-.4-1-1.1-1.3-1.1-1.3-.9-.6.07-.6.07-.6 1 .07 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.85.09-.65.35-1.1.63-1.35-2.1-.23-4.3-1.05-4.3-4.65 0-1.03.37-1.87.98-2.53-.1-.24-.42-1.2.09-2.5 0 0 .8-.25 2.6.97a9 9 0 0 1 4.73 0c1.8-1.22 2.6-.97 2.6-.97.51 1.3.19 2.26.1 2.5.6.66.97 1.5.97 2.53 0 3.61-2.2 4.41-4.3 4.64.36.31.67.91.67 1.84v2.73" />
    </g>
  )}
  {name === 'youtube' && (
    <g>
      <rect x="1.8" y="4.4" width="16.4" height="11.2" />
      <path d="M8.4 7.6l4.6 2.4-4.6 2.4z" stroke-linejoin="miter" />
    </g>
  )}
  {name === 'medium' && (
    <g>
      <ellipse cx="5.4" cy="10" rx="3.4" ry="4.6" />
      <ellipse cx="12.6" cy="10" rx="1.5" ry="4.6" />
      <path d="M17.4 5.6v8.8" stroke-linecap="square" />
    </g>
  )}
  {name === 'credly' && (
    <g>
      <path d="M10 2.2l6.4 2.6v4.8c0 3.4-2.5 6.3-6.4 8.2-3.9-1.9-6.4-4.8-6.4-8.2V4.8z" stroke-linejoin="miter" />
      <path d="M7.2 9.8l2 2 3.6-3.8" stroke-linecap="square" />
    </g>
  )}
  {name === 'x' && (
    <g>
      <path d="M3.2 3.2l13.6 13.6M16.8 3.2L3.2 16.8" stroke-linecap="square" />
    </g>
  )}
  {name === 'mail' && (
    <g>
      <rect x="1.9" y="4.2" width="16.2" height="11.6" />
      <path d="M1.9 4.8L10 11l8.1-6.2" stroke-linejoin="miter" />
    </g>
  )}
  {name === 'whatsapp' && (
    <g>
      <path d="M3.1 16.9l1-3.3A7 7 0 1 1 6.6 16z" stroke-linejoin="miter" />
      <path d="M7.4 7.3c.5 2.6 2.7 4.8 5.3 5.3l1-1.3 1.4.7v1.3c-3.6.6-7.8-3-8.1-7h1.3z" />
    </g>
  )}
  {name === 'download' && (
    <g>
      <path d="M10 2.6v9.6M6.2 8.6L10 12.4l3.8-3.8" stroke-linecap="square" />
      <path d="M3 15.4v2h14v-2" stroke-linecap="square" />
    </g>
  )}
  {name === 'arrow' && (
    <g>
      <path d="M3.4 10h12.6M11.6 5.6L16 10l-4.4 4.4" stroke-linecap="square" />
    </g>
  )}
  {name === 'external' && (
    <g>
      <path d="M11.4 3.2H16.8V8.6" stroke-linecap="square" />
      <path d="M16.8 3.2L9 11" stroke-linecap="square" />
      <path d="M14 11.8v5h-11v-11h5" stroke-linecap="square" />
    </g>
  )}
  {name === 'play' && (
    <g>
      <circle cx="10" cy="10" r="7.6" />
      <path d="M8.2 6.6l5 3.4-5 3.4z" stroke-linejoin="miter" />
    </g>
  )}
</svg>

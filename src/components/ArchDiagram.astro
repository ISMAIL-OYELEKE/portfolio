---
/* A project's real architecture diagram (public/diagrams) with its traffic
   animated on it: in each numbered step, small packets glide along that
   step's own arrows, while the caption reads the step from the legend.
   `cropped` drops the title band and legend for the compact project stage.
   The diagram loads only when it is first shown. Without JavaScript, or with
   reduced motion, it is the plain diagram with step 1 in the caption. */
import { diagramFlows } from '../data/diagramFlows';

interface Props {
  slug: string;
  alt: string;
  cropped?: boolean;
  /** Start playing on its own once on screen (case study pages). */
  auto?: boolean;
  /** Load the drawing with the page instead of when first shown. */
  eager?: boolean;
}
const { slug, alt, cropped = false, auto = false, eager = auto } = Astro.props;
const flow = diagramFlows[slug];
const box = cropped ? flow.crop : [0, 0, flow.w, flow.h];
const first = flow.steps[0];
---

<figure class:list={['adg', { 'adg--cropped': cropped }]} data-adg data-auto={auto ? '' : undefined} data-flow={JSON.stringify(flow.steps)}>
  <div class="adg__sheet">
    <svg viewBox={box.join(' ')} role="img" aria-label={alt} preserveAspectRatio="xMidYMid meet">
      <image data-adg-img href={eager ? `/diagrams/${slug}.svg` : undefined} width={flow.w} height={flow.h}></image>
      <g data-adg-pk></g>
    </svg>
  </div>
  <figcaption class="adg__cap">
    <span class="adg__step" data-adg-step><b>Step {first.n} of {flow.steps.length}.</b> {first.text}</span>
    <a class="adg__full" href={`/diagrams/${slug}.svg`} target="_blank" rel="noopener" data-adg-src>Full size</a>
  </figcaption>
</figure>

<style>
  .adg {
    margin: 0;
    min-width: 0;
  }
  .adg__sheet {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    padding: 0.5rem;
    overflow: hidden;
  }
  .adg__sheet svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The same packets as the old flow drawings: small amber dots that glide
     along the diagram's own arrows, easing in and out at each end. */
  .adg :global(.adg__p) {
    fill: #e0a33a;
    stroke: #fff;
    stroke-width: 3;
  }
  .adg__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    margin-top: 0.7rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    min-height: 2.8em;
  }
  .adg__step {
    flex: 1 1 18rem;
  }
  .adg__step b {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .adg__full {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>

<script>
  type Step = { n: number; text: string; paths: [number, number][][] };
  const NS = 'http://www.w3.org/2000/svg';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Each step shows for STEP_MS; packets fade in and out at its edges.
  const STEP_MS = 2400;
  const FADE_MS = 300;
  // Laps per second along an arrow, and packets per arrow.
  const SPEED = 0.55;
  const PER_ARROW = 2;

  const lengthOf = (p: [number, number][]) => p.slice(1).reduce((s, q, i) => s + Math.hypot(q[0] - p[i][0], q[1] - p[i][1]), 0);
  const pointAt = (p: [number, number][], d: number): [number, number] => {
    for (let i = 1; i < p.length; i++) {
      const l = Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]);
      if (d <= l) {
        const k = l ? d / l : 0;
        return [p[i - 1][0] + (p[i][0] - p[i - 1][0]) * k, p[i - 1][1] + (p[i][1] - p[i - 1][1]) * k];
      }
      d -= l;
    }
    return p[p.length - 1];
  };

  document.querySelectorAll<HTMLElement>('[data-adg]').forEach((root) => {
    const steps: Step[] = JSON.parse(root.dataset.flow || '[]');
    const img = root.querySelector<SVGImageElement>('[data-adg-img]')!;
    const pkG = root.querySelector<SVGGElement>('[data-adg-pk]')!;
    const cap = root.querySelector<HTMLElement>('[data-adg-step]')!;
    const src = root.querySelector<HTMLAnchorElement>('[data-adg-src]')!.getAttribute('href')!;
    let visible = false;
    let playing = false;
    let step = 0;
    let t0 = 0;
    let raf = 0;
    let packets: { c: SVGCircleElement; p: [number, number][]; L: number; o: number }[] = [];

    const load = () => {
      if (!img.getAttribute('href')) img.setAttribute('href', src);
    };
    const show = (i: number) => {
      step = i;
      const s = steps[i];
      pkG.innerHTML = '';
      packets = s.paths.flatMap((p, k) => {
        const L = lengthOf(p);
        return Array.from({ length: PER_ARROW }, (_, j) => {
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('r', '12');
          c.setAttribute('class', 'adg__p');
          c.style.opacity = '0';
          pkG.appendChild(c);
          return { c, p, L, o: j / PER_ARROW + k * 0.17 };
        });
      });
      cap.innerHTML = `<b>Step ${s.n} of ${steps.length}.</b> `;
      cap.append(s.text);
    };
    const frame = (now: number) => {
      if (!playing) return;
      const e = now - t0;
      const edge = Math.min(1, e / FADE_MS, (STEP_MS - e) / FADE_MS);
      packets.forEach(({ c, p, L, o }) => {
        const f = ((e / 1000) * SPEED + o) % 1;
        const [x, y] = pointAt(p, L * f);
        c.setAttribute('cx', String(x));
        c.setAttribute('cy', String(y));
        c.style.opacity = String(Math.max(0, edge) * Math.min(1, Math.sin(f * Math.PI) * 2));
      });
      if (e >= STEP_MS) {
        if (step === steps.length - 1) root.dispatchEvent(new CustomEvent('adg:cycle', { bubbles: true }));
        // The listener may have stopped this diagram to move on to the next one.
        if (!playing) return;
        show((step + 1) % steps.length);
        t0 = now;
      }
      raf = requestAnimationFrame(frame);
    };
    const play = () => {
      load();
      if (reduce || playing || !steps.length) return;
      playing = true;
      t0 = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      playing = false;
      cancelAnimationFrame(raf);
    };

    // The project stage tells each diagram when it is the one on show.
    root.addEventListener('adg:play', () => {
      show(0);
      if (visible) play();
      else load();
      root.dataset.on = '';
    });
    root.addEventListener('adg:stop', () => {
      stop();
      delete root.dataset.on;
    });
    if (root.dataset.auto !== undefined) root.dataset.on = '';

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && root.dataset.on !== undefined) play();
        else if (!visible) stop();
      },
      { rootMargin: '200px 0px' },
    ).observe(root);

    if (steps.length) show(0);
  });
</script>

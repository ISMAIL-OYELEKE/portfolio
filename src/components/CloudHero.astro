---
/* The home page opening: the Lagos skyline on the lagoon, a commit rising
   off a rooftop, a climb through the clouds, then the DevOps loop and the
   name in clear sky, which fades into the page below. Day in Light theme, night in Dark. The scroll
   drives it. With reduced motion the section shows its final frame. */
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';

// The opening line, typed out letter by letter: each letter carries its
// place in the line (--c) so CSS alone can time it from the first paint.
const titleLines = [['Every', 'system', 'starts'], ['on', 'the', 'ground.']];
let charAt = 0;
const title = titleLines.map((line) =>
  line.map((text) => {
    const word = { text, em: text === 'ground.', chars: [...text].map((ch) => ({ ch, c: charAt++ })) };
    return word;
  }),
);
const lastChar = charAt - 1;

const loopPath =
  'M300,150 C370,50 545,50 545,150 C545,250 370,250 300,150 C230,50 55,50 55,150 C55,250 230,250 300,150 Z';
---

<section class="on-dark flight" data-flight aria-label="Introduction">
  <div class="flight__scene">
    <canvas class="flight__sky" data-flight-sky aria-hidden="true"></canvas>
    <div class="flight__commit" data-commit aria-hidden="true"></div>

    <div class="flight__intro" data-intro aria-hidden="true">
      <span class="eyebrow">{site.locality}, {site.country}</span>
      <p class="flight__title" aria-label="Every system starts on the ground.">
        {
          title.map((line, li) => (
            <Fragment>
              {line.map((word, wi) => {
                const letters = word.chars.map(({ ch, c }) => (
                  <span class:list={['c', { 'c--end': c === lastChar }]} style={`--c:${c}`}>{ch}</span>
                ));
                return (
                  <Fragment>
                    <span class="w">{word.em ? <em>{letters}</em> : letters}</span>
                    {wi < line.length - 1 ? ' ' : ''}
                  </Fragment>
                );
              })}
              {li === 0 && <br />}
            </Fragment>
          ))
        }
      </p>
      <p class="flight__note">This one ends up in the cloud. Scroll to take it there.</p>
    </div>

    <div class="flight__alt" data-alt aria-hidden="true">
      Altitude<b data-alt-value>0 m</b>
    </div>

    <div class="flight__stage" data-stage>
      <div class="flight__loopwrap">
        <svg
          class="flight__loop"
          data-loop
          viewBox="0 0 600 300"
          role="img"
          aria-label="The DevOps loop: plan, code, build, test, release, deploy, operate, monitor"
        >
          <path class="flight__track" d={loopPath}></path>
          <path class="flight__ink" data-ink d={loopPath}></path>
          <text class="flight__big" x="150" y="150">Dev</text>
          <text class="flight__big" x="450" y="150">Ops</text>
          <g data-labels></g>
          <g data-packets></g>
        </svg>
      </div>
      <h1 class="flight__name" data-name>{site.name}</h1>
      <p class="flight__role" data-reveal>
        <b>Cloud and DevOps Engineer</b> · AWS Certified Solutions Architect
      </p>
      <div class="flight__ctas" data-reveal>
        <a class="btn btn--primary" href="/contact">
          Hire me
          <SocialIcon name="arrow" size={15} />
        </a>
        <a class="btn btn--ghost" href="/projects">See what I've shipped</a>
      </div>
    </div>

    <div class="flight__cue" data-cue aria-hidden="true">Scroll to lift off<i></i></div>
    <div class="flight__fade" data-fade aria-hidden="true"></div>
  </div>
</section>

<style>
  .flight {
    --mast: 73px;
    position: relative;
    background: var(--brand-deep);
  }
  .flight__scene {
    position: relative;
    height: calc(100svh - var(--mast));
    min-height: 560px;
    overflow: hidden;
  }
  /* The painted sky's own colours, day and night, shown from the first paint. */
  .flight__scene {
    background: linear-gradient(#1d58a4, #8fc0ea);
  }
  :global(:root[data-theme='dark']) .flight__scene {
    background: linear-gradient(#060e1b, #1a2f4f);
  }
  /* The flight's scroll length is set from the first paint too, not when the
     script arrives, so the page never changes height under the reader. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not(.no-js)) .flight {
      height: 400vh;
    }
    :global(:root:not(.no-js)) .flight .flight__scene {
      position: sticky;
      top: var(--mast);
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 640px) {
    :global(:root:not(.no-js)) .flight {
      height: 350vh;
    }
  }
  /* The scroll-driven version, switched on by the script. */
  /* The last part of the scroll holds the finished frame (name, role and
     buttons) still, so it can be read before the page moves on. */
  .flight.is-flying {
    height: 400vh;
  }
  .flight.is-flying .flight__scene {
    position: sticky;
    top: var(--mast);
  }
  @media (max-width: 640px) {
    .flight.is-flying {
      height: 350vh;
    }
  }

  .flight__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The live sky fades in over a plain sky of the same colours, so the page
     never shows an empty box while the script loads. */
  :global(:root:not(.no-js)) .flight__sky {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  :global(:root:not(.no-js)) .flight__sky.is-drawn {
    opacity: 1;
  }

  /* Pieces that only exist in the flight are hidden in the still version. */
  .flight__commit,
  .flight__intro,
  .flight__alt,
  .flight__cue {
    display: none;
  }
  .is-flying :is(.flight__commit, .flight__intro, .flight__alt, .flight__cue) {
    display: block;
  }
  /* With JavaScript on, the flight script starts a moment after first paint.
     Until it does, show the opening frame (the intro), never the end frame,
     so the name does not flash before "Every system starts on the ground". */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not(.no-js)) .flight:not(.is-flying) .flight__stage {
      visibility: hidden;
    }
    :global(:root:not(.no-js)) .flight:not(.is-flying) :is(.flight__intro, .flight__cue) {
      display: block;
    }
  }

  .flight__intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    text-align: center;
    padding-inline: var(--gutter);
  }
  .flight__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0.4rem auto 0;
    max-width: none;
    color: var(--paper);
  }
  .flight__title em {
    font-style: normal;
    color: var(--highlight);
  }
  /* Words never break inside; each letter is typed in on its own beat. */
  .flight__title .w {
    white-space: nowrap;
  }
  .flight__title .c {
    position: relative;
  }

  /* The opening, on first load: the place, then the line typed out letter by
     letter with an amber caret, then the two hints. `backwards` hands opacity
     back to the scroll script once each piece is in place. */
  @media (prefers-reduced-motion: no-preference) {
    .flight__intro .eyebrow {
      animation: fl-fade 0.6s ease-out 0.1s backwards;
    }
    .flight__title .c {
      animation: fl-type 1ms steps(1) backwards;
      animation-delay: calc(0.45s + var(--c) * 65ms);
    }
    .flight__title .c::after {
      content: '';
      position: absolute;
      top: 0.12em;
      bottom: 0.02em;
      right: -0.05em;
      width: 0.055em;
      background: var(--highlight);
      opacity: 0;
      animation: fl-caret 65ms steps(1);
      animation-delay: calc(0.45s + var(--c) * 65ms);
    }
    .flight__title .c--end::after {
      animation: fl-caret-end 2.6s steps(1);
      animation-delay: calc(0.45s + var(--c) * 65ms);
    }
    .flight__note {
      animation: fl-fade 0.8s ease-out 2.7s backwards;
    }
    .flight__cue,
    .flight__alt {
      animation: fl-fade 0.8s ease-out 3s backwards;
    }
  }
  @keyframes fl-type {
    from {
      opacity: 0;
    }
  }
  @keyframes fl-caret {
    from {
      opacity: 1;
    }
  }
  @keyframes fl-caret-end {
    0%,
    30%,
    60% {
      opacity: 1;
    }
    15%,
    45%,
    75% {
      opacity: 0;
    }
  }
  @keyframes fl-fade {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  /* The hints have no box: a soft, close shadow keeps them readable over
     the skyline and the sky in both themes. */
  .flight__note,
  .flight__alt,
  .flight__cue {
    text-shadow:
      0 1px 2px rgb(15 30 51 / 0.85),
      0 0 12px rgb(15 30 51 / 0.55);
  }
  .flight__note {
    color: var(--paper);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 500;
    margin: 1.3rem auto 0;
    max-width: 34rem;
  }

  .flight__commit {
    position: absolute;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    background: var(--highlight);
    border-radius: 2px;
    opacity: 0;
  }

  .flight__alt {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #dfe7f1;
    text-align: right;
  }
  .flight__alt b {
    display: block;
    color: var(--paper);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  @media (max-width: 640px) {
    .flight__alt {
      top: 1rem;
      left: var(--gutter);
      right: auto;
      transform: none;
      text-align: left;
    }
  }

  .flight__cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper);
    text-align: center;
    white-space: nowrap;
  }
  .flight__cue i {
    display: block;
    width: 2px;
    height: 34px;
    margin: 0.6rem auto 0;
    background: rgb(255 255 255 / 0.4);
    position: relative;
    overflow: hidden;
  }
  .flight__cue i::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 12px;
    background: var(--highlight);
    animation: cue-drip 1.6s infinite;
  }
  @keyframes cue-drip {
    from {
      top: -12px;
    }
    to {
      top: 34px;
    }
  }

  /* At the end of the flight the sky fades into the page below, so the hero
     flows into the next section without a hard edge. */
  .flight__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14%;
    background: linear-gradient(to bottom, rgb(244 245 242 / 0), var(--paper));
    opacity: var(--end, 0);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .flight__fade {
    background: linear-gradient(to bottom, rgb(10 21 38 / 0), var(--brand-ink));
  }

  .flight__stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem var(--gutter);
    text-align: center;
  }
  .is-flying .flight__stage {
    pointer-events: none;
    opacity: 0;
  }
  .is-flying .flight__stage.is-live {
    pointer-events: auto;
  }
  .flight__loopwrap {
    width: min(600px, 92vw);
    perspective: 900px;
  }
  .flight__loop {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flight__track {
    fill: none;
    stroke: var(--brand-line);
    stroke-width: 3;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
  }
  .flight__ink {
    fill: none;
    stroke: #6a9ad6;
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  .flight__big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    fill: var(--paper);
    text-anchor: middle;
    dominant-baseline: middle;
  }
  .flight__loop :global(.lbl) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.12em;
    fill: #a9b6c8;
    text-anchor: middle;
    dominant-baseline: middle;
    transition: fill 0.2s ease;
  }
  .flight__loop :global(.lbl.is-hot) {
    fill: var(--highlight);
  }
  .flight__loop :global(.pk) {
    fill: var(--highlight);
  }

  .flight__name {
    font-size: clamp(2.8rem, 9vw, 7.2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0.5rem 0 0;
    white-space: nowrap;
    color: var(--paper);
  }
  .flight__name :global(span) {
    display: inline-block;
    will-change: transform, opacity;
  }
  .flight__role {
    margin: 1rem auto 0;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.85rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a9b6c8;
    max-width: none;
  }
  .flight__role b {
    color: var(--highlight);
    font-weight: 500;
  }
  .flight__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 1.6rem;
  }

  @media (max-width: 640px) {
    .flight__name {
      font-size: clamp(2.3rem, 11vw, 3rem);
    }
    .flight__loop :global(.lbl) {
      font-size: 15px;
    }
  }

  /* Daytime flight (Light theme): a blue sky, so the line work goes white. */
  :global(:root[data-theme='light']) .flight__ink {
    stroke: var(--paper);
  }
  :global(:root[data-theme='light']) .flight__track {
    stroke: rgb(255 255 255 / 0.35);
  }
  :global(:root[data-theme='light']) .flight__loop :global(.lbl),
  :global(:root[data-theme='light']) .flight__role {
    color: #e6eef8;
    fill: #e6eef8;
  }
  :global(:root[data-theme='light']) .flight__loop :global(.lbl.is-hot),
  :global(:root[data-theme='light']) .flight__role b,
  :global(:root[data-theme='light']) .flight__intro .eyebrow,
  :global(:root[data-theme='light']) .flight__title em {
    color: #ffd27a;
  }
</style>

<script>
  import { createSky } from '../scripts/flight-sky';

  const section = document.querySelector<HTMLElement>('[data-flight]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section) {
    // A reload always starts at the opening of the flight, not wherever the
    // page was last scrolled to.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    const navEntry = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (navEntry?.type === 'reload' && !location.hash) window.scrollTo(0, 0);

    const NS = 'http://www.w3.org/2000/svg';
    const q = <T extends Element>(sel: string) => section.querySelector<T>(sel)!;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

    /* ---- the DevOps loop: labels and packets ---- */
    const ink = q<SVGPathElement>('[data-ink]');
    const L = ink.getTotalLength();
    const labelsG = q<SVGGElement>('[data-labels]');
    const stages: [string, number, number][] = [
      ['RELEASE', 0.11, 450], ['DEPLOY', 0.2, 450], ['OPERATE', 0.3, 450], ['MONITOR', 0.39, 450],
      ['PLAN', 0.61, 150], ['CODE', 0.7, 150], ['BUILD', 0.8, 150], ['TEST', 0.89, 150],
    ];
    const labels = stages.map(([t, f, cx]) => {
      const pt = ink.getPointAtLength(f * L);
      const dx = pt.x - cx, dy = pt.y - 150, m = Math.hypot(dx, dy) || 1;
      const el = document.createElementNS(NS, 'text');
      el.setAttribute('class', 'lbl');
      el.setAttribute('x', String(pt.x + (dx / m) * 30));
      el.setAttribute('y', String(pt.y + (dy / m) * 24));
      el.textContent = t;
      labelsG.appendChild(el);
      return { el, f };
    });
    const packetsG = q<SVGGElement>('[data-packets]');
    const packets = [0, 0.33, 0.66].map((o) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('class', 'pk');
      c.setAttribute('r', '6');
      packetsG.appendChild(c);
      return { c, o };
    });

    const spin = (t: number, on: boolean) => {
      const pos = packets.map((k) => (t * 0.12 + k.o) % 1);
      packets.forEach((k, i) => {
        const pt = ink.getPointAtLength(pos[i] * L);
        k.c.setAttribute('cx', String(pt.x));
        k.c.setAttribute('cy', String(pt.y));
        k.c.style.opacity = on ? '1' : '0';
      });
      labels.forEach(({ el, f }) => {
        const near = pos.some((pf) => Math.min(Math.abs(pf - f), 1 - Math.abs(pf - f)) < 0.04);
        el.classList.toggle('is-hot', on && near);
      });
    };

    const sky = createSky(q<HTMLCanvasElement>("[data-flight-sky]"));

    /* Still version: the final frame, redrawn when the theme changes. */
    if (reduce) {
      spin(0, true);
      section.style.setProperty('--end', '1');
      const still = () => sky.draw(1, 0);
      still();
      document.addEventListener('themechange', still);
      window.addEventListener('resize', still);
    } else {
      section.classList.add('is-flying');

      /* ---- name, letter by letter ---- */
      const nameEl = q<HTMLElement>('[data-name]');
      const text = nameEl.textContent || '';
      nameEl.setAttribute('aria-label', text);
      nameEl.textContent = '';
      const letters = [...text].map((ch) => {
        const s = document.createElement('span');
        s.setAttribute('aria-hidden', 'true');
        s.textContent = ch === ' ' ? ' ' : ch;
        nameEl.appendChild(s);
        // Letters gather from nearby, scaled to the screen, so none flies in from off the page.
        const spread = Math.min(1, window.innerWidth / 1100);
        return { s, dx: (rnd() - 0.5) * 420 * spread, dy: ((rnd() - 0.5) * 260 - 60) * spread, r: (rnd() - 0.5) * 90 };
      });

      const intro = q<HTMLElement>('[data-intro]');
      const commit = q<HTMLElement>('[data-commit]');
      const loop = q<SVGSVGElement>('[data-loop]');
      const stage = q<HTMLElement>('[data-stage]');
      const cue = q<HTMLElement>('[data-cue]');
      const alt = q<HTMLElement>('[data-alt]');
      const altValue = q<HTMLElement>('[data-alt-value]');
      const reveals = [...section.querySelectorAll<HTMLElement>('[data-reveal]')];
      ink.style.strokeDasharray = String(L);

      const render = (p: number, t: number) => {
        const vh = section.querySelector<HTMLElement>('.flight__scene')!.clientHeight;
        sky.draw(p, t);
        intro.style.opacity = String(1 - seg(p, 0.04, 0.16));
        intro.style.transform = `translateY(${seg(p, 0, 0.2) * -60}px)`;
        cue.style.opacity = String(1 - seg(p, 0, 0.06));

        const cr = seg(p, 0.02, 0.42);
        commit.style.top = `${vh * 0.86 - ease(cr) * vh * 0.42}px`;
        commit.style.opacity = p < 0.02 ? '0' : String(1 - seg(p, 0.44, 0.5));
        commit.style.transform = `rotate(${cr * 360}deg)`;

        altValue.textContent = `${Math.round(ease(seg(p, 0, 0.6)) * 10000).toLocaleString('en-GB')} m`;
        alt.style.opacity = String(p < 0.02 ? 0.5 : 1 - seg(p, 0.62, 0.7));

        const la = seg(p, 0.5, 0.68);
        stage.style.opacity = la > 0 ? '1' : '0';
        stage.classList.toggle('is-live', p > 0.85);
        loop.style.opacity = String(seg(p, 0.5, 0.56));
        loop.style.transform = `rotateY(${(1 - ease(la)) * 540}deg) scale(${0.6 + 0.4 * ease(la)})`;
        ink.style.strokeDashoffset = String(L * (1 - ease(seg(p, 0.54, 0.72))));

        letters.forEach((l, i) => {
          const k = ease(seg(p, 0.7 + i * 0.007, 0.8 + i * 0.007));
          l.s.style.opacity = String(k);
          l.s.style.transform = `translate(${l.dx * (1 - k)}px, ${l.dy * (1 - k)}px) rotate(${l.r * (1 - k)}deg)`;
        });
        reveals.forEach((el, i) => {
          const k = seg(p, 0.86 + i * 0.04, 0.94 + i * 0.04);
          el.style.opacity = String(k);
          el.style.transform = `translateY(${(1 - k) * 16}px)`;
        });
        section.style.setProperty('--end', String(seg(p, 0.78, 0.92)));
        return p > 0.7;
      };

      const sceneEl = section.querySelector<HTMLElement>('.flight__scene')!;
      // The flight plays over the first 80% of the scroll; the rest holds the
      // finished frame. Progress eases towards the scroll position, so a
      // mouse wheel's steps turn into one smooth glide.
      const PLAY = 0.8;
      let shown = -1;
      let last = 0;
      const tick = (now: number) => {
        const r = section.getBoundingClientRect();
        const dt = Math.min(100, now - (last || now));
        last = now;
        // Skip the work while the hero is scrolled out of sight.
        if (r.bottom > 0) {
          const top = parseFloat(getComputedStyle(sceneEl).top) || 0;
          const target = clamp((top - r.top) / (section.offsetHeight - sceneEl.clientHeight) / PLAY);
          shown = shown < 0 ? target : shown + (target - shown) * (1 - Math.exp(-dt / 140));
          if (Math.abs(target - shown) < 0.0005) shown = target;
          const t = now / 1000;
          spin(t, render(shown, t));
        } else shown = -1;
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>

---
/* Every AWS service and tool the cloud projects use, in one sky. Picking a
   project lights its services and draws the path between them; any service
   can be dragged. The list underneath is plain links, so it works without
   JavaScript and every case study stays one click away. */
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

// One name per service, so "Amazon S3" and "S3" meet in the same place.
const rename: Record<string, string> = {
  'Application Load Balancer': 'ALB',
  'AWS Certificate Manager': 'ACM',
  'RDS PostgreSQL': 'RDS',
  'RDS MySQL': 'RDS',
  'Amazon VPC': 'VPC',
  'VPC endpoints': 'VPC',
  'Amazon Lex V2': 'Lex',
  'AWS Lightsail': 'Lightsail',
};
const skip = new Set(['Python 3.9', 'JavaScript', 'Web Chat', 'Bitnami', 'Linux', 'Let’s Encrypt', 'k6']);
const norm = (s: string) => rename[s] ?? s.replace(/^(Amazon|AWS) /, '');

const items = projects.map((p) => ({
  slug: p.slug,
  title: p.title,
  date: p.date,
  context: p.context,
  summary: p.summary,
  services: [...new Set(p.stack.filter((s) => !skip.has(s)).map(norm))],
}));
const services = [...new Set(items.flatMap((p) => p.services))];
---

<div class="sky-grid">
  <div class="sky" data-sky data-services={JSON.stringify(services)} data-projects={JSON.stringify(items.map((p) => p.services))}>
    <svg viewBox="0 0 600 600" aria-hidden="true">
      <g data-edges></g>
      <g data-nodes></g>
    </svg>
    <span class="sky__hint">Drag any service</span>
  </div>

  <div>
    <ol class="sky-list">
      {
        items.map((p, i) => (
          <li data-pick={i} data-summary={p.summary}>
            <a href={`/projects/${p.slug}`}>
              <span class="sky-list__date">{p.date}</span>
              <span class="sky-list__title">{p.title}</span>
              <span class="sky-list__context">{p.context}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="sky-detail" data-detail aria-live="polite">{items[0]?.summary}</p>
  </div>
</div>

<style>
  .sky-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .sky-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sky {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    touch-action: pan-y;
    user-select: none;
  }
  .sky svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .sky :global(.edge) {
    fill: none;
    stroke: var(--highlight);
    stroke-width: 1.6;
  }
  .sky :global(.node) {
    cursor: grab;
    touch-action: none;
  }
  .sky :global(.node rect) {
    fill: var(--bg);
    stroke: var(--rule);
    stroke-width: 1.5;
    transition: stroke 0.3s ease;
  }
  .sky :global(.node text) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
  }
  .sky :global(.node.is-hot rect) {
    stroke: var(--highlight);
  }
  .sky :global(.node.is-hot text) {
    fill: var(--text);
  }
  .sky__hint {
    position: absolute;
    left: 1rem;
    bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sky-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .sky-list li {
    border-bottom: 1px solid var(--rule);
  }
  .sky-list a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 1rem 0.25rem;
    text-decoration: none;
  }
  .sky-list__date {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: 0.35rem;
  }
  .sky-list__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    transition: color 0.2s ease;
  }
  .sky-list__context {
    font-size: 0.86rem;
    color: var(--text-muted);
  }
  .sky-list li.is-on .sky-list__title,
  .sky-list a:hover .sky-list__title {
    color: var(--accent);
  }
  .sky-detail {
    margin-top: 1.2rem;
    color: var(--text-muted);
    min-height: 4.5em;
  }
  @media (max-width: 560px) {
    .sky-list a {
      grid-template-columns: minmax(0, 1fr);
    }
    .sky-list__date {
      grid-row: auto;
      padding-top: 0;
    }
  }
</style>

<script>
  const sky = document.querySelector<HTMLElement>('[data-sky]');
  if (sky) {
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const services: string[] = JSON.parse(sky.dataset.services || '[]');
    const projects: string[][] = JSON.parse(sky.dataset.projects || '[]');
    const nodesG = sky.querySelector<SVGGElement>('[data-nodes]')!;
    const edgesG = sky.querySelector<SVGGElement>('[data-edges]')!;
    const svg = sky.querySelector('svg')!;
    const picks = [...document.querySelectorAll<HTMLElement>('[data-pick]')];
    const detail = document.querySelector<HTMLElement>('[data-detail]');
    const summaries = picks.map((li) => li.dataset.summary || '');
    const W = 600, H = 600;

    let seed = 11;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const cols = 4;
    const rows = Math.ceil(services.length / cols);
    const pos: Record<string, { x: number; y: number }> = {};
    services.forEach((s, i) => {
      const col = i % cols, row = Math.floor(i / cols);
      pos[s] = {
        x: 85 + col * 135 + (row % 2 ? 22 : -6) + (rnd() - 0.5) * 14,
        y: 40 + row * ((H - 90) / Math.max(1, rows - 1)) + (rnd() - 0.5) * 16,
      };
    });

    const nodes: Record<string, SVGGElement> = {};
    services.forEach((s) => {
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', 'node');
      const w = s.length * 7 + 18;
      g.innerHTML = `<rect x="${-w / 2}" y="-13" width="${w}" height="26" rx="3"/><text>${s}</text>`;
      nodesG.appendChild(g);
      nodes[s] = g;
    });

    let current = 0;
    let dragging: string | null = null;

    const draw = (animate: boolean) => {
      services.forEach((s) => nodes[s].setAttribute('transform', `translate(${pos[s].x},${pos[s].y})`));
      const d = (projects[current] || []).map((s, i) => `${i ? 'L' : 'M'}${pos[s].x},${pos[s].y}`).join(' ');
      edgesG.innerHTML = d ? `<path class="edge" d="${d}"/>` : '';
      const path = edgesG.firstElementChild as SVGPathElement | null;
      if (path && animate && !reduce) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = String(len);
        path.style.strokeDashoffset = String(len);
        path.getBoundingClientRect();
        path.style.transition = 'stroke-dashoffset 0.9s ease-out';
        path.style.strokeDashoffset = '0';
      }
    };

    const select = (i: number) => {
      if (i === current && picks[i]?.classList.contains('is-on')) return;
      current = i;
      picks.forEach((li, j) => li.classList.toggle('is-on', j === i));
      services.forEach((s) => nodes[s].classList.toggle('is-hot', (projects[i] || []).includes(s)));
      if (detail) detail.textContent = summaries[i] || '';
      draw(true);
    };

    picks.forEach((li, i) => {
      li.addEventListener('mouseenter', () => select(i));
      li.addEventListener('focusin', () => select(i));
    });
    select(0);

    const toSvg = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
    };
    nodesG.addEventListener('pointerdown', (e) => {
      const g = (e.target as Element).closest('.node');
      if (!g) return;
      dragging = services.find((s) => nodes[s] === g) || null;
      (g as SVGGElement).setPointerCapture(e.pointerId);
    });
    nodesG.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const p = toSvg(e);
      pos[dragging] = { x: Math.min(W - 40, Math.max(40, p.x)), y: Math.min(H - 20, Math.max(20, p.y)) };
      draw(false);
    });
    const end = () => (dragging = null);
    nodesG.addEventListener('pointerup', end);
    nodesG.addEventListener('pointercancel', end);
  }
</script>

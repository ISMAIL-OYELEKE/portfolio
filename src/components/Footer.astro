---
import { nav, site, socials } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import { brandStyle } from '../lib/brands';
import logo from '../assets/logo/lockup-stacked-reversed.svg';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell">
    <p class="footer__you" data-visitor>
      This site runs on Route 53, CloudFront and S3, deployed by GitHub Actions. I built that too.
    </p>
  </div>
  <div class="shell footer__grid">
    <div>
      <img src={logo.src} alt={site.name} width="150" height="120" class="footer__logo" />
      <p class="footer__line">
        {site.role} in {site.locality}, {site.country}.
      </p>
      <ul class="footer__socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} style={brandStyle(s.icon)} class:list={{ 'is-wordmark': s.icon === 'credly' }}>
                <SocialIcon name={s.icon} size={s.icon === 'credly' ? 42 : 18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Pages</h2>
      <ul class="footer__list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
        <li><a href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>
      </ul>
      <address class="footer__address">
        {site.locality}, {site.region}<br />
        {site.country}
      </address>
    </div>
  </div>

  <div class="shell footer__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul class="footer__legal">
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
      <li><button type="button" data-cookie-reopen>Cookie settings</button></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--brand-ink);
    color: var(--paper);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--brand-line);
  }

  .footer__you {
    max-width: 46rem;
    margin: 0 auto 2.75rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--brand-line);
    text-align: center;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #c3cede;
  }
  .footer__you :global(b) {
    color: var(--highlight);
    font-weight: 500;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    padding-bottom: 2.75rem;
  }

  .footer__logo {
    height: 84px;
    width: auto;
    margin-bottom: 1.1rem;
  }

  .footer__line {
    color: #a9b6c8;
    font-size: 0.92rem;
    max-width: 24rem;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--highlight);
    margin-bottom: 1rem;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__list a {
    overflow-wrap: anywhere;
    color: #c3cede;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .footer__list a:hover {
    color: var(--paper);
    text-decoration: underline;
  }

  .footer__address {
    font-style: normal;
    color: #a9b6c8;
    font-size: 0.92rem;
    margin-top: 1.1rem;
  }

  .footer__socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--brand-line);
    border-radius: var(--r-sharp);
    color: var(--brand-on-dark, #c3cede);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  /* Credly's mark is a wordmark, so it gets a wider tile to stay legible. */
  .footer__socials a.is-wordmark {
    width: 62px;
  }
  .footer__socials a:hover,
  .footer__socials a:focus-visible {
    background: var(--brand, var(--highlight));
    border-color: var(--brand, var(--highlight));
    color: #fff;
    transform: translateY(-2px);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--brand-line);
    padding-block: 1.3rem 1.6rem;
    font-size: 0.82rem;
    color: #a9b6c8;
  }
  .footer__base p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__legal a,
  .footer__legal button {
    color: #a9b6c8;
    font-size: 0.82rem;
    font-family: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .footer__legal a:hover,
  .footer__legal button:hover {
    color: var(--highlight);
  }

  @media (max-width: 620px) {
    .footer__grid {
      text-align: center;
    }
    .footer__line {
      margin-inline: auto;
    }
    .footer__socials {
      justify-content: center;
      flex-wrap: wrap;
    }
    .footer__base {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>

<script>
  // Greets the visitor by their own city and time, read from the browser's
  // time zone, and says how long this page took to reach them. Nothing is
  // sent anywhere; it is all worked out on their device.
  const line = document.querySelector<HTMLElement>('[data-visitor]');
  if (line) {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      const place = tz.includes('/') ? (tz.split('/').pop() || '').replace(/_/g, ' ') : '';
      const time = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const ms = nav && nav.responseEnd ? Math.round(nav.responseEnd) : 0;
      const b = (s: string) => `<b>${s.replace(/[<>&]/g, '')}</b>`;
      // Only the live domain is served by CloudFront; a preview copy says so plainly.
      const live = location.hostname === 'ismailoyeleke.com' || location.hostname.endsWith('.ismailoyeleke.com');
      line.innerHTML =
        (place ? `You are reading this in ${b(place)} at ${b(time)}. ` : '') +
        (live
          ? `This page reached you through Route 53, CloudFront and S3${ms ? ` in ${b(`${ms} ms`)}` : ''}, deployed by GitHub Actions. I built that too.`
          : 'This is a preview copy. The live site runs on Route 53, CloudFront and S3, deployed by GitHub Actions. I built that too.');
    } catch {
      /* keep the plain sentence */
    }
  }
</script>

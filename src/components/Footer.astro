---
import { nav, site, socials } from '../data/site';
import SocialIcon from './SocialIcon.astro';
import logo from '../assets/logo/lockup-stacked-reversed.svg';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__grid">
    <div>
      <img src={logo.src} alt={site.name} width="150" height="120" class="footer__logo" />
      <p class="footer__line">
        {site.role} in {site.locality}, {site.country}.
      </p>
      <ul class="footer__socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label}>
                <SocialIcon name={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Pages</h2>
      <ul class="footer__list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
        <li><a href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>
      </ul>
      <address class="footer__address">
        {site.locality}, {site.region}<br />
        {site.country}
      </address>
    </div>
  </div>

  <div class="shell footer__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul class="footer__legal">
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
      <li><button type="button" data-cookie-reopen>Cookie settings</button></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--green-ink);
    color: var(--ivory);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--green-line);
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    padding-bottom: 2.75rem;
  }

  .footer__logo {
    height: 84px;
    width: auto;
    margin-bottom: 1.1rem;
  }

  .footer__line {
    color: #a8bdb1;
    font-size: 0.92rem;
    max-width: 24rem;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__list a {
    overflow-wrap: anywhere;
    color: #c6d6cc;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .footer__list a:hover {
    color: var(--ivory);
    text-decoration: underline;
  }

  .footer__address {
    font-style: normal;
    color: #a8bdb1;
    font-size: 0.92rem;
    margin-top: 1.1rem;
  }

  .footer__socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--green-line);
    border-radius: var(--r-sharp);
    color: #c6d6cc;
  }
  .footer__socials a:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--green-line);
    padding-block: 1.3rem 1.6rem;
    font-size: 0.82rem;
    color: #a8bdb1;
  }
  .footer__base p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__legal a,
  .footer__legal button {
    color: #a8bdb1;
    font-size: 0.82rem;
    font-family: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .footer__legal a:hover,
  .footer__legal button:hover {
    color: var(--gold);
  }

  @media (max-width: 620px) {
    .footer__base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import portrait from '../assets/headshot/headshot-portrait-green.jpg';

interface Props {
  alt: string;
  width?: number;
  /** Width below 900px, so the portrait never fills a phone screen. */
  smallWidth?: number;
  priority?: boolean;
}
const { alt, width = 440, smallWidth = 240, priority = false } = Astro.props;
---

<figure class="arch" style={`--w:${width}px;--w-sm:${smallWidth}px`}>
  <Image
    src={portrait}
    alt={alt}
    widths={[320, 440, 640, 880]}
    sizes={`(max-width: 720px) 72vw, ${width}px`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    format="webp"
    quality={78}
  />
</figure>

<style>
  /* Arched frame with a thin gold outline, the one ornamental shape on the
     page. The flat colour background of the portrait carries the brand green,
     so no gradient or glow is needed behind it. */
  .arch {
    /* Never taller than about half the screen, so it cannot push the page
       content below the fold on a short laptop display. */
    --arch-w: min(var(--w), 48vh);
    position: relative;
    margin: 0;
    width: min(100%, var(--arch-w));
    aspect-ratio: 4 / 5;
    border: 1px solid var(--gold);
    border-radius: calc(var(--arch-w) / 2) calc(var(--arch-w) / 2) var(--r-card) var(--r-card);
    padding: 10px;
  }
  .arch::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: calc(var(--arch-w) / 2) calc(var(--arch-w) / 2) 1px 1px;
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .arch {
      --arch-w: var(--w-sm);
    }
  }

  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: calc(var(--arch-w) / 2) calc(var(--arch-w) / 2) 1px 1px;
    display: block;
  }
</style>

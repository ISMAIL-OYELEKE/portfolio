---
/* The projects on the home and Projects pages: a list of projects on the
   left that moves on by itself, the project's real AWS diagram with traffic
   running through it in the middle, and the write-up on the right. Case study
   sits under the diagram; code and video sit under the write-up. On phones
   the list becomes a stepper and the case study link moves up top.
   Without JavaScript every project shows, one after another. */
import ArchDiagram from './ArchDiagram.astro';
import SocialIcon from './SocialIcon.astro';
import type { Project } from '../data/projects';
import { diagramFlows } from '../data/diagramFlows';

interface Props {
  projects: Project[];
}
const list = Astro.props.projects.filter((p) => diagramFlows[p.slug]);
const short = (t: string) => t.replace(/ on AWS$/, '').replace(/^This Portfolio:.*/, 'This portfolio').replace(/ for ThinkFinance MFB$/, '');
const month = (d: string) => d.replace(/^(\w{3})\w*/, '$1').toUpperCase();
---

<div class="ps" data-ps>
  <div class="ps__list" role="tablist" aria-label="Projects" aria-orientation="vertical">
    {
      list.map((p, i) => (
        <button type="button" class="ps__item" role="tab" id={`ps-tab-${i}`} aria-controls={`ps-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ps-tab={i}>
          <span class="ps__name">{short(p.title)}</span>
          <span class="ps__date">{month(p.date)}</span>
          <i class="ps__timer" aria-hidden="true" />
        </button>
      ))
    }
  </div>

  <div class="ps__step" aria-hidden="true">
    <button type="button" class="ps__arrow" data-ps-move="-1" tabindex="-1">‹</button>
    <span><b data-ps-name>{short(list[0].title)}</b><small data-ps-count>1 of {list.length}</small></span>
    <button type="button" class="ps__arrow" data-ps-move="1" tabindex="-1">›</button>
  </div>

  {
    list.map((p, i) => (
      <div class="ps__panel" role="tabpanel" id={`ps-panel-${i}`} aria-labelledby={`ps-tab-${i}`} data-ps-panel={i}>
        <a class="btn btn--primary ps__case ps__case--top" href={`/projects/${p.slug}`}>
          Read the case study
          <SocialIcon name="arrow" size={15} />
        </a>
        <div class="ps__visual">
          <ArchDiagram slug={p.slug} alt={p.diagram?.alt ?? `${p.title} architecture`} cropped eager={i === 0} />
          <a class="btn btn--primary ps__case ps__case--under" href={`/projects/${p.slug}`}>
            Case study
            <SocialIcon name="arrow" size={15} />
          </a>
        </div>
        <div class="ps__copy">
          <span class="ps__meta">{p.date} · {p.context.replace(/^Built at /, '')}</span>
          <h3 class="ps__title">{p.title}</h3>
          <p class="ps__sum">{p.summary}</p>
          <ul class="ps__stack">{p.stack.slice(0, 5).map((s) => <li>{s}</li>)}</ul>
          {(p.repo || p.video) && (
            <div class="ps__links">
              {p.repo && (
                <a class="btn btn--ghost" href={p.repo} target="_blank" rel="noopener">
                  <SocialIcon name="github" size={15} />
                  Code
                </a>
              )}
              {p.video && (
                <a class="btn btn--ghost" href={p.video} target="_blank" rel="noopener">
                  <SocialIcon name="youtube" size={15} />
                  Video
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .ps {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: 1.5rem clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  .ps__list {
    grid-row: 1 / span 2;
    display: grid;
    gap: 0.35rem;
  }
  .ps__item {
    position: relative;
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.65rem 0.85rem;
    background: transparent;
    border: 0;
    border-left: 2px solid var(--rule);
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
    overflow: hidden;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ps__item:hover {
    color: var(--text);
  }
  .ps__item[aria-selected='true'] {
    border-left-color: var(--highlight);
    background: color-mix(in srgb, var(--highlight) 12%, transparent);
    color: var(--text);
  }
  .ps__item:focus-visible {
    outline: 2px solid var(--highlight);
    outline-offset: 2px;
  }
  .ps__name {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .ps__date {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  /* A thin bar fills while the list waits to move on. */
  .ps__timer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background: var(--highlight);
  }
  .ps.is-auto .ps__item[aria-selected='true'] .ps__timer {
    animation: ps-fill var(--ps-dwell, 9s) linear forwards;
  }
  @keyframes ps-fill {
    to {
      width: 100%;
    }
  }

  .ps__step {
    display: none;
  }
  .ps__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  /* With the script, only the chosen project shows. */
  .ps.is-live .ps__panel:not(.is-on) {
    display: none;
  }
  .ps:not(.is-live) .ps__panel + .ps__panel {
    grid-column: 2;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .ps__visual {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .ps__case--under {
    justify-self: end;
  }
  .ps__case--top {
    display: none;
  }
  .ps__copy {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }
  .ps__meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ps__title {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }
  .ps__sum {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .ps__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ps__stack li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule);
    color: var(--text-muted);
  }
  .ps__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* Laptops just narrower than a desktop: the write-up goes under the diagram. */
  @media (max-width: 1180px) and (min-width: 761px) {
    .ps__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phones: a stepper replaces the list, the case study link sits on top, and
     code and video sit side by side. */
  @media (max-width: 760px) {
    .ps {
      grid-template-columns: minmax(0, 1fr);
    }
    .ps.is-live .ps__list {
      display: none;
    }
    .ps.is-live .ps__step {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.4rem;
      border: 1px solid var(--rule);
      text-align: center;
    }
    .ps__step span {
      display: grid;
      gap: 0.1rem;
    }
    .ps__step b {
      font-weight: 600;
      font-size: 0.98rem;
    }
    .ps__step small {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      text-transform: uppercase;
    }
    .ps__arrow {
      width: 2.75rem;
      height: 2.75rem;
      background: transparent;
      border: 1px solid var(--rule);
      color: var(--highlight);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }
    .ps__panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .ps:not(.is-live) .ps__panel + .ps__panel {
      grid-column: auto;
    }
    .ps__case--top {
      display: inline-flex;
      justify-content: center;
    }
    .ps__case--under {
      display: none;
    }
    .ps__links .btn {
      flex: 1 1 0;
      justify-content: center;
    }
  }
</style>

<script>
  const DWELL_MIN = 9000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ps-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-ps-panel]')];
    const diagrams = panels.map((p) => p.querySelector<HTMLElement>('[data-adg]')!);
    const name = root.querySelector<HTMLElement>('[data-ps-name]')!;
    const count = root.querySelector<HTMLElement>('[data-ps-count]')!;
    let current = 0;
    // Moves on by itself until the visitor picks a project.
    let auto = !reduce && panels.length > 1;
    let onScreen = false;
    let timer = 0;

    root.classList.add('is-live');

    const show = (i: number, focus = false) => {
      const n = (i + panels.length) % panels.length;
      diagrams[current]?.dispatchEvent(new CustomEvent('adg:stop'));
      current = n;
      tabs.forEach((t, k) => {
        const on = k === n;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, k) => p.classList.toggle('is-on', k === n));
      name.textContent = tabs[n].querySelector('.ps__name')!.textContent;
      // The fill bar lasts as long as one full run of this diagram's steps.
      const stepCount = JSON.parse(diagrams[n].dataset.flow || '[]').length;
      root.style.setProperty('--ps-dwell', `${Math.max(DWELL_MIN, stepCount * 2400)}ms`);
      count.textContent = `${n + 1} of ${panels.length}`;
      diagrams[n].dispatchEvent(new CustomEvent('adg:play'));
      // Warm the next diagram so it is ready when the list moves on.
      const next = diagrams[(n + 1) % panels.length].querySelector<SVGImageElement>('[data-adg-img]');
      const href = diagrams[(n + 1) % panels.length].querySelector('[data-adg-src]')?.getAttribute('href');
      if (next && href && !next.getAttribute('href')) window.setTimeout(() => next.setAttribute('href', href), 1500);
      if (focus) tabs[n].focus();
      // Restart the fill bar.
      root.classList.remove('is-auto');
      void root.offsetWidth;
      root.classList.toggle('is-auto', auto && onScreen);
    };

    // Move on once the shown diagram has played every step, and not before the dwell.
    let shownAt = performance.now();
    root.addEventListener('adg:cycle', () => {
      if (!auto || !onScreen) return;
      const wait = Math.max(0, DWELL_MIN - (performance.now() - shownAt));
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        shownAt = performance.now();
        show(current + 1);
      }, wait);
    });

    const pick = (i: number, focus = false) => {
      auto = false;
      window.clearTimeout(timer);
      shownAt = performance.now();
      show(i, focus);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => pick(i)));
    root.querySelector('.ps__list')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowDown' || k === 'ArrowRight') pick(current + 1, true);
      else if (k === 'ArrowUp' || k === 'ArrowLeft') pick(current - 1, true);
      else return;
      e.preventDefault();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-ps-move]').forEach((b) =>
      b.addEventListener('click', () => pick(current + Number(b.dataset.psMove))),
    );

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      root.classList.toggle('is-auto', auto && onScreen);
    }).observe(root);

    show(0);
  });
</script>

---
import { Image } from 'astro:assets';
import portrait from '../assets/headshot/headshot-portrait-cutout.png';

interface Props {
  alt: string;
  width?: number;
  /** Width below 900px, so the portrait never fills a phone screen. */
  smallWidth?: number;
  priority?: boolean;
}
const { alt, width = 440, smallWidth = 240, priority = false } = Astro.props;
---

<figure class="portrait" style={`--w:${width}px;--w-sm:${smallWidth}px`}>
  <Image
    src={portrait}
    alt={alt}
    widths={[320, 440, 640, 880]}
    sizes={`(max-width: 720px) 72vw, ${width}px`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    format="webp"
    quality={80}
  />
</figure>

<style>
  /* No frame: the photo has a transparent background, so Ismail stands
     straight on the page colour. The photo cuts through his shoulders at
     the sides and bottom, so a mask fades those edges into the page
     instead of ending on a hard line. */
  .portrait {
    /* Never taller than about half the screen, so it cannot push the page
       content below the fold on a short laptop display. */
    --portrait-w: min(var(--w), 48vh);
    margin: 0;
    width: min(100%, var(--portrait-w));
    aspect-ratio: 4 / 5;
  }
  @media (max-width: 900px) {
    .portrait {
      --portrait-w: var(--w-sm);
    }
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    display: block;
    /* Two fades, kept only where both are opaque: one along the bottom and
       one at each side, where the photo crops his shoulders. */
    --fade-x: linear-gradient(to right, transparent 0, #000 14%, #000 86%, transparent 100%);
    --fade-y: linear-gradient(to bottom, #000 62%, transparent 96%);
    -webkit-mask-image: var(--fade-x), var(--fade-y);
    -webkit-mask-composite: source-in;
    mask-image: var(--fade-x), var(--fade-y);
    mask-composite: intersect;
  }
</style>

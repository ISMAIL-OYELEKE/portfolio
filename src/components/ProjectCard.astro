---
import type { Project } from '../data/projects';
import SocialIcon from './SocialIcon.astro';

interface Props {
  project: Project;
  /** The first card in a list runs wide, so the grid is not three equal boxes. */
  wide?: boolean;
}
const { project, wide = false } = Astro.props;
---

<article class:list={['pcard', wide && 'pcard--wide', 'reveal']}>
  <div class="pcard__meta">
    <span class="pcard__date">{project.date}</span>
    <span class="pcard__context">{project.context}</span>
  </div>

  <h3 class="pcard__title">
    <a href={`/projects/${project.slug}`}>{project.title}</a>
  </h3>

  <p class="pcard__summary">{project.summary}</p>

  <ul class="tag-row pcard__stack">
    {project.stack.slice(0, wide ? 7 : 5).map((s) => <li class="tag">{s}</li>)}
    {project.stack.length > (wide ? 7 : 5) && <li class="tag">+{project.stack.length - (wide ? 7 : 5)}</li>}
  </ul>

  <div class="pcard__foot">
    <a class="text-link" href={`/projects/${project.slug}`}>
      Read the case study
      <SocialIcon name="arrow" size={14} />
    </a>
    {
      project.video && (
        <a class="text-link" href={project.video} target="_blank" rel="noopener">
          Watch demo
          <SocialIcon name="external" size={13} />
        </a>
      )
    }
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    padding: clamp(1.4rem, 3vw, 2.1rem);
    transition: border-color 0.2s ease;
  }
  .pcard:hover {
    border-color: var(--accent-line);
  }

  .pcard--wide {
    grid-column: 1 / -1;
  }

  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .pcard__date {
    color: var(--accent);
  }
  .pcard__context {
    color: var(--text-muted);
  }

  .pcard__title {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    margin-bottom: 0.5rem;
  }
  .pcard--wide .pcard__title {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .pcard__title a {
    text-decoration: none;
  }
  /* The whole card is the hit area, with the real link still in the heading. */
  .pcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard__title a:hover {
    color: var(--accent);
  }

  .pcard__summary {
    color: var(--text-muted);
    margin-bottom: 1.3rem;
    max-width: 58ch;
  }
  .pcard--wide .pcard__summary {
    font-size: 1.05rem;
    max-width: 64ch;
  }

  .pcard__stack {
    margin-bottom: 1.5rem;
  }

  .pcard__foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
  }
  .pcard__foot .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    position: relative;
    z-index: 1;
  }
</style>

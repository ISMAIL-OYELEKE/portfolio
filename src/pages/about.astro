---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ArchPortrait from '../components/ArchPortrait.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../data/site';
import { story, values, remember, education, community } from '../data/experience';
import { skillGroups } from '../data/skills';

const description =
  'Ismail Oyeleke: how an IT support role at Nigeria’s airports led to AWS architecture, what he values in a build, and the community he founded in Lagos.';
---

<Base title="About" description={description} type="profile">
  <PageHero eyebrow="About" title="From keeping the lights on to designing what stays up" lede={site.shortBio} />

  <section class="section">
    <div class="shell about__grid">
      <div class="about__story">
        {story.map((para) => <p>{para}</p>)}

        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">
            Work with me
            <SocialIcon name="arrow" size={15} />
          </a>
          <a class="btn btn--ghost" href={site.cv} download>
            <SocialIcon name="download" size={15} />
            Download CV
          </a>
        </div>
      </div>

      <aside class="about__aside">
        <ArchPortrait alt={`${site.name} in Lagos`} width={320} />

        <div class="panel">
          <h2 class="panel__heading">Education</h2>
          <p class="panel__strong">{education.degree}</p>
          <p class="panel__line">{education.school}</p>
          <p class="panel__line">{education.result}</p>
          <p class="panel__line">Graduated {education.graduated}</p>
          <p class="panel__line">Final-year research: {education.research}</p>
        </div>

        <div class="panel">
          <h2 class="panel__heading">Community</h2>
          <p class="panel__strong">{community.founded.name}</p>
          <p class="panel__line">
            {community.founded.role}, {community.founded.period}. {community.founded.detail}
          </p>
          <p class="panel__line">
            <a class="text-link" href={community.founded.href} target="_blank" rel="noopener">
              Join CloudUp
              <SocialIcon name="external" size={13} />
            </a>
          </p>
          <p class="panel__line panel__line--spaced">
            Member of {community.memberships.join(', ')}.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="on-dark section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">In short</span>
        <h2>Five things worth knowing</h2>
        <span class="rule-gold"></span>
      </div>

      <ol class="numbered">
        {
          remember.map((item, i) => (
            <li class="numbered__item reveal">
              <span class="numbered__n">{String(i + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">How I work</span>
        <h2>What I hold to on every build</h2>
        <span class="rule-gold"></span>
      </div>

      <dl class="values">
        {
          values.map((v) => (
            <div class="values__item reveal">
              <dt>{v.title}</dt>
              <dd>{v.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Toolkit</span>
        <h2>Skills</h2>
        <span class="rule-gold"></span>
      </div>

      <div class="skills">
        {
          skillGroups.map((g) => (
            <section class="skills__group reveal">
              <h3 class="skills__title">{g.title}</h3>
              <ul class="tag-row">
                {g.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <p class="note">
        Outside work: chess and running clubs. Based in {site.locality}, {site.country}, and open to{' '}
        {site.openTo}.
      </p>
    </div>
  </section>
</Base>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    align-items: start;
  }

  .about__story p {
    font-size: 1.04rem;
  }

  .about__aside {
    display: grid;
    gap: 1.5rem;
  }

  .panel {
    border: 1px solid var(--rule);
    border-left: 2px solid var(--gold);
    border-radius: var(--r-card);
    padding: 1.3rem 1.4rem;
    background: var(--surface);
  }
  .panel__heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .panel__strong {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .panel__line {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }
  .panel__line--spaced {
    margin-top: 0.9rem;
  }

  .numbered {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }
  .numbered__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    background: var(--bg);
    padding: 1.4rem 0;
  }
  .numbered__n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .numbered__item p {
    margin: 0;
    max-width: 68ch;
  }

  .values {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    margin: 0;
  }
  /* An odd last item spans the row rather than sitting alone in it. */
  .values__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .values__item {
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    padding: 1.4rem;
    background: var(--surface);
  }
  .values dt {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .values dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .skills {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
  }
  .skills__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .note {
    margin-top: 2.5rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .numbered__item {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
  }
</style>

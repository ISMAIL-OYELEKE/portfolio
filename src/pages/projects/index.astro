---
import { isWide } from '../../lib/grid';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArchStage from '../../components/ArchStage.astro';
import FreelanceSystems from '../../components/FreelanceSystems.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { cloudProjects } from '../../data/projects';

const description =
  'AWS projects with the decisions behind them: a serverless staff portal, an Amazon Connect contact centre, a multi-AZ web architecture and a Lex chatbot.';
---

<Base title="Projects" description={description}>
  <PageHero
    eyebrow="Projects"
    title="What I built, and why it was built that way"
    lede="Each case study covers the problem, the architecture, the decisions I would defend in a review, and what the result actually is."
  />

  <section class="on-dark section">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Live architectures</span>
        <h2>Watch each one provision and carry traffic</h2>
        <p class="lede">
          Pick a system. It builds itself, then requests flow through every service it runs on, in the
          order they really travel.
        </p>
      </div>
      <ArchStage projects={cloudProjects} />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Cloud and DevOps</span>
        <h2>AWS projects</h2>
        <span class="rule-tick"></span>
      </div>

      <div class="grid grid--pair">
        {cloudProjects.map((p, i, all) => <ProjectCard project={p} wide={isWide(i, all.length)} />)}
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Freelance software</span>
        <h2>Client systems</h2>
        <p class="lede">
          Production software built for businesses in Lagos. Both are live, and both are named with
          the client's agreement.
        </p>
        <span class="rule-tick"></span>
      </div>

      <FreelanceSystems />

      <div class="btn-row">
        <a class="btn btn--ghost" href="/freelance">
          More on freelance work
          <SocialIcon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>
</Base>

---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import KestrelLab from '../../components/KestrelLab.astro';
import { diagramFlows } from '../../data/diagramFlows';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/proof/*.png', {
  eager: true,
});
const shotFor = (src: string) => shots[`../../assets/proof/${src}`]?.default;

const related = projects.filter((p) => p.slug !== project.slug && p.kind === project.kind).slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  author: { '@type': 'Person', name: site.name, url: site.url },
  dateCreated: project.dateISO,
  keywords: project.stack.join(', '),
  url: new URL(`/projects/${project.slug}`, Astro.site).href,
};
---

<Base
  title={project.metaTitle ?? project.title}
  description={project.metaDescription ?? project.summary}
  type="article"
  schema={schema}
>
  <article>
    <header class="on-dark case-hero">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/projects">Projects</a>
          <span aria-hidden="true">/</span>
          <span>{project.kind === 'cloud' ? 'AWS' : 'Freelance'}</span>
        </nav>

        <div class="case-hero__grid">
          <div class="case-hero__intro">
            <h1>{project.title}</h1>
            <p class="lede case-hero__summary">{project.summary}</p>
          </div>

          <div class="case-card">
            <dl class="case-facts">
              <div>
                <dt>When</dt>
                <dd>{project.date}</dd>
              </div>
              <div>
                <dt>Context</dt>
                <dd>{project.context}</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>Solo build</dd>
              </div>
            </dl>

            <ul class="tag-row case-card__stack">
              {project.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>

            {
              (project.repo || project.live || project.article || project.linkedin) && (
                <div class="case-card__links">
                  {project.repo && (
                    <a class="btn btn--ghost" href={project.repo} target="_blank" rel="noopener">
                      <SocialIcon name="github" size={15} />
                      View the code
                    </a>
                  )}
                  {project.live && (
                    <a class="btn btn--ghost" href={project.live} target="_blank" rel="noopener">
                      <SocialIcon name="external" size={15} />
                      Visit the site
                    </a>
                  )}
                  {project.article && (
                    <a class="btn btn--ghost" href={project.article} target="_blank" rel="noopener">
                      <SocialIcon name="medium" size={15} />
                      Read on Medium
                    </a>
                  )}
                  {project.linkedin && (
                    <a class="btn btn--ghost" href={project.linkedin} target="_blank" rel="noopener">
                      <SocialIcon name="linkedin" size={15} />
                      LinkedIn post
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <!-- The stage strip only sticks while the case study itself is on screen. -->
    <div class="case-track">
    <nav class="stages" data-stages aria-label="On this page" hidden></nav>
    <div class="section">
      <div class="shell case-body">
        <section id="problem" data-step="Problem">
          <h2>The problem</h2>
          <p>{project.problem}</p>
        </section>

        {
          diagramFlows[project.slug] && (
            <section class="live" id="flow" data-step="Architecture">
              <h2>The architecture, live</h2>
              <p>
                The real diagram, drawn with the official AWS icons. Each numbered step lights up in order,
                with traffic moving along the path it really takes.
              </p>
              <ArchDiagram slug={project.slug} alt={project.diagram?.alt ?? `${project.title} architecture`} auto />
            </section>
          )
        }

        {project.slug === 'kestrel-loan-platform' && <div id="lab" data-step="Experiments"><KestrelLab /></div>}

        {project.video && <VideoEmbed url={project.video} title={project.title} />}

        {
          project.media?.map((m) =>
            m.type === 'video' ? (
              <figure class="shot">
                <video
                  src={m.src}
                  poster={m.poster}
                  controls
                  muted
                  playsinline
                  preload="none"
                  width="1280"
                  height="720"
                  aria-label={m.alt}
                ></video>
                {m.caption && <figcaption>{m.caption}</figcaption>}
              </figure>
            ) : shotFor(m.src) ? (
              <figure class="shot">
                <Image src={shotFor(m.src)!} alt={m.alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 760px" format="webp" quality={80} />
                {m.caption && <figcaption>{m.caption}</figcaption>}
              </figure>
            ) : null
          )
        }

        {
          project.build.map((block, i) => (
            <section id={`build-${i}`} data-step={i === 0 ? 'Build' : undefined}>
              <h2>{block.heading}</h2>
              <ul class="bullets">
                {block.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>
          ))
        }

        {
          project.decisions && (
            <section id="decisions" data-step="Decisions">
              <h2>Decisions</h2>
              <dl class="decisions">
                {project.decisions.map((d) => (
                  <div class="decisions__item lift">
                    <dt>{d.title}</dt>
                    <dd>{d.body}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        {
          project.lessons && (
            <section id="lessons" data-step="Lessons">
              <h2>What went wrong, and what fixed it</h2>
              <ul class="bullets">
                {project.lessons.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          project.result && (
            <section id="result" data-step="Result">
              <h2>The result</h2>
              <ul class="bullets">
                {project.result.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </section>
          )
        }

        {project.note && <p class="case-note">{project.note}</p>}
      </div>
    </div>
    </div>

    <section class="section section--sunken">
      <div class="shell">
        <div class="section-head">
          <span class="eyebrow">Keep reading</span>
          <h2>Other work</h2>
          <span class="rule-tick"></span>
        </div>
        <ul class="related">
          {
            related.map((r) => (
              <li>
                <a href={`/projects/${r.slug}`}>
                  <span class="related__kicker">{r.date}</span>
                  <span class="related__title">{r.title}</span>
                  <span class="related__arrow">
                    <SocialIcon name="arrow" size={16} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">
            Talk about a project like this
            <SocialIcon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  /* The case study as a pipeline: each part is a stage that goes green once
     read, and a click jumps to it. */
  const nav = document.querySelector<HTMLElement>('[data-stages]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  if (nav && steps.length > 2) {
    const ol = document.createElement('ol');
    const links = steps.map((s) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${s.id}`;
      a.textContent = s.dataset.step!;
      li.append(a);
      ol.append(li);
      return li;
    });
    nav.append(ol);
    nav.hidden = false;
    let last = -2;
    const update = () => {
      const line = window.innerHeight * 0.35;
      let active = -1;
      steps.forEach((s, i) => {
        if (s.getBoundingClientRect().top < line) active = i;
      });
      if (active === last) return;
      last = active;
      links.forEach((li, i) => {
        li.classList.toggle('is-done', i < active);
        li.classList.toggle('is-active', i === active);
      });
      // On narrow screens keep the current stage in view in the strip.
      const cur = links[Math.max(0, active)];
      ol.scrollTo({ left: cur.offsetLeft - ol.clientWidth / 2 + cur.offsetWidth / 2 });
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .stages {
    position: sticky;
    top: 72px;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .stages[hidden] {
    display: none;
  }
  .stages :global(ol) {
    list-style: none;
    margin: 0 auto;
    padding: 0.7rem 1rem;
    display: flex;
    justify-content: safe center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    max-width: 60rem;
  }
  .stages :global(ol) {
    position: relative;
  }
  .stages :global(li) {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
  }
  .stages :global(li + li)::before {
    content: '';
    width: 1.6rem;
    height: 2px;
    background: var(--rule);
    margin: 0 0.4rem;
    transition: background-color 0.3s ease;
  }
  .stages :global(li.is-done + li)::before,
  .stages :global(li.is-done + li.is-active)::before {
    background: var(--highlight);
  }
  .stages :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .stages :global(a)::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--rule);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .stages :global(li.is-done a),
  .stages :global(li.is-active a) {
    color: var(--text);
  }
  .stages :global(li.is-done a)::before {
    background: var(--highlight);
    border-color: var(--highlight);
  }
  .stages :global(li.is-active a)::before {
    border-color: var(--highlight);
    animation: stage-pulse 1.4s ease-in-out infinite;
  }
  @keyframes stage-pulse {
    50% {
      background: var(--highlight);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stages :global(li.is-active a)::before {
      animation: none;
    }
  }
  /* Phones: every stage is a dot on one line, and only the current one
     shows its name, so the whole pipeline fits without sideways scrolling. */
  @media (max-width: 640px) {
    .stages :global(ol) {
      justify-content: center;
      padding-inline: 0.5rem;
    }
    .stages :global(li + li)::before {
      width: 0.9rem;
      margin: 0 0.3rem;
    }
    .stages :global(li:not(.is-active) a) {
      font-size: 0;
      gap: 0;
    }
  }
  .case-body > [id] {
    scroll-margin-top: 140px;
  }
  .case-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .crumbs a {
    color: var(--highlight);
    text-decoration: none;
  }

  /* Everything sits on the centre line: crumbs, title and summary, then
     one strip with When, Context and Role in equal columns, then the
     stack and the links. On phones the strip stacks into rows. */
  .case-hero .shell {
    text-align: center;
  }
  .crumbs {
    justify-content: center;
  }
  .case-hero__grid {
    display: grid;
    gap: 2.25rem;
  }
  .case-hero h1 {
    font-size: clamp(2rem, 4.4vw, 3.3rem);
    max-width: 24ch;
    margin: 0 auto 0.5em;
  }
  .case-hero__summary {
    max-width: 60ch;
    margin: 0 auto;
  }

  .case-card {
    display: grid;
    gap: 1.4rem;
  }
  .case-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--rule);
  }
  .case-facts > div {
    padding: 1.1rem 1.4rem;
  }
  .case-facts > div + div {
    border-left: 1px solid var(--rule);
  }
  .case-facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.45rem;
  }
  .case-facts dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .case-card__stack,
  .case-card__links {
    justify-content: center;
  }
  .case-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 700px) {
    .case-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-facts > div {
      padding: 0.9rem 0;
    }
    .case-facts > div + div {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .case-card__links {
      display: grid;
      justify-items: stretch;
    }
    .case-card__links .btn {
      justify-content: center;
    }
  }

  .case-body {
    max-width: 50rem;
  }
  .case-body > section + section,
  .case-body > section + .shot {
    margin-top: 2.75rem;
  }
  .case-body h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    margin-bottom: 0.7rem;
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.5rem;
    max-width: 68ch;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.85rem;
    height: 1px;
    background: var(--highlight);
  }

  .decisions {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .decisions__item {
    border: 1px solid var(--rule);
    border-top: 2px solid var(--highlight);
    border-radius: var(--r-card);
    padding: 1.3rem;
    background: var(--surface);
  }
  .decisions dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    margin-bottom: 0.4rem;
  }
  .decisions dd {
    margin: 0;
    color: var(--text-muted);
  }

  .shot {
    margin: 2.25rem 0;
  }
  .shot :global(img),
  .shot video {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--r-card);
    display: block;
  }
  .shot figcaption {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.6rem;
  }

  .case-note {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--highlight);
    background: var(--bg-sunken);
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: none;
  }

  .related {
    list-style: none;
    margin: 0 auto;
    max-width: 56rem;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .related a {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .related a:hover .related__title {
    color: var(--accent);
  }
  .related__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex: 0 0 9rem;
  }
  .related__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .related__arrow {
    margin-left: auto;
    color: var(--accent);
    display: flex;
  }
</style>

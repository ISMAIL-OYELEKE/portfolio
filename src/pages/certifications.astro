---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import SocialIcon from '../components/SocialIcon.astro';
import { headlineCerts, badgeGroups, certCount } from '../data/certifications';

const description = `All ${certCount} of Ismail Oyeleke's certifications and badges, including AWS Certified Solutions Architect Associate and KCNA, each linking to the issuer for verification.`;
---

<Base title="Certifications" description={description}>
  <PageHero
    eyebrow="Certifications"
    title={`${certCount} certifications and badges, all verifiable`}
    lede="Every badge links to its issuer, so you can check any of them in one click."
  />

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Professional certifications</span>
        <h2>The four that count</h2>
        <span class="rule-tick"></span>
      </div>

      <ul class="headline">
        {
          headlineCerts.map((c) => (
            <li class="headline__item lift reveal" data-tilt>
              {c.image && (
                <Image
                  class="headline__badge"
                  src={c.image}
                  alt={`${c.name} badge`}
                  width={104}
                  height={104}
                  densities={[1, 2]}
                  format="webp"
                />
              )}
              <p class="headline__issuer">{c.issuer}</p>
              <h3 class="headline__name">{c.name}</h3>
              <p class="headline__dates">
                {c.issued && <span>Issued {c.issued}</span>}
                {c.expires && <span>Valid to {c.expires}</span>}
              </p>
              {c.issued && c.expires && /\D/.test(c.issued) && (
                <div class="ttl" data-issued={c.issued} data-expires={c.expires} hidden>
                  <span class="ttl__bar">
                    <span />
                  </span>
                  <span class="ttl__text" />
                </div>
              )}
              <a class="text-link" href={c.verify} target="_blank" rel="noopener">
                Verify with issuer
                <SocialIcon name="external" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="on-dark section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Training</span>
        <h2>Course and training badges</h2>
        <p class="lede">Grouped by issuer. Each badge links to its own verification page.</p>
        <span class="rule-tick"></span>
      </div>

      <div class="filter" role="group" aria-label="Filter badges by issuer" data-filter hidden>
        <button type="button" class="chip" aria-pressed="true" data-issuer="">
          All <span>{badgeGroups.reduce((n, g) => n + g.badges.length, 0)}</span>
        </button>
        {
          badgeGroups.map((g) => (
            <button type="button" class="chip" aria-pressed="false" data-issuer={g.issuer}>
              {g.issuer} <span>{g.badges.length}</span>
            </button>
          ))
        }
      </div>

      {
        badgeGroups.map((group) => (
          <section class="group" data-group={group.issuer}>
            <h3 class="group__title">{group.issuer}</h3>
            <ul class="badges">
              {group.badges.map((b) => (
                <li class="badges__item">
                  <a href={b.verify} target="_blank" rel="noopener">
                    <span class:list={['badges__art', b.imageShape === 'certificate' && 'badges__art--cert']}>
                      {b.image ? (
                        <Image
                          src={b.image}
                          alt={`${b.name} ${b.imageShape === 'certificate' ? 'certificate' : 'badge'}`}
                          width={b.imageShape === 'certificate' ? 220 : 112}
                          densities={[1, 2]}
                          format="webp"
                          loading="lazy"
                        />
                      ) : (
                        <span class="badges__placeholder" aria-hidden="true">
                          {group.issuer.split(' ')[0]}
                        </span>
                      )}
                    </span>
                    <span class="badges__name">{b.name}</span>
                    <span class="badges__meta">
                      {b.issued && <span class="badges__date">{b.issued}</span>}
                      <span class="badges__verify">
                        Verify
                        <SocialIcon name="external" size={12} />
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const months = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
  const parse = (s: string) => {
    const [m, y] = s.toLowerCase().split(' ');
    return Number(y) * 12 + months.indexOf(m);
  };

  /* Validity as a time to live: how much of each certification's life is left. */
  document.querySelectorAll<HTMLElement>('.ttl').forEach((el) => {
    const from = parse(el.dataset.issued!), to = parse(el.dataset.expires!);
    const d = new Date();
    const now = d.getFullYear() * 12 + d.getMonth();
    if (Number.isNaN(from) || Number.isNaN(to) || to <= from) return;
    const left = Math.max(0, to - now);
    const used = Math.min(1, Math.max(0, (now - from) / (to - from)));
    el.hidden = false;
    el.querySelector<HTMLElement>('.ttl__text')!.textContent =
      left > 0 ? `TTL: about ${left} months of validity left` : 'Due for renewal';
    const bar = el.querySelector<HTMLElement>('.ttl__bar span')!;
    bar.style.width = `${(1 - used) * 100}%`;
  });

  /* A gentle tilt toward the pointer on the four that count. */
  if (!reduce && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(700px) rotateX(${(-y * 7).toFixed(2)}deg) rotateY(${(x * 7).toFixed(2)}deg)`;
      });
      card.addEventListener('pointerleave', () => (card.style.transform = ''));
    });
  }

  /* Filter the badge wall by issuer. */
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  if (filter) {
    filter.hidden = false;
    const chips = [...filter.querySelectorAll<HTMLButtonElement>('[data-issuer]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const pick = c.dataset.issuer;
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
        groups.forEach((g) => {
          const show = !pick || g.dataset.group === pick;
          g.hidden = !show;
          if (show && !reduce) {
            g.classList.remove('is-in');
            void g.offsetWidth;
            g.classList.add('is-in');
          }
        });
      }),
    );
  }
</script>

<style>
  [data-tilt] {
    transition:
      transform 0.25s var(--ease-out),
      translate 0.25s var(--ease-out),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .ttl {
    margin: 0.2rem 0 0.9rem;
  }
  .ttl[hidden] {
    display: none;
  }
  .ttl__bar {
    display: block;
    height: 4px;
    background: var(--rule);
    margin-bottom: 0.4rem;
  }
  .ttl__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--highlight);
    transition: width 1.2s var(--ease-out);
  }
  .ttl__text {
    display: block;
    line-height: 1.4;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }
  .filter[hidden] {
    display: none;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.45rem 0.75rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--rule);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .chip span {
    color: var(--text-muted);
    margin-left: 0.25rem;
  }
  .chip:hover {
    border-color: var(--highlight);
  }
  .chip[aria-pressed='true'] {
    background: var(--highlight);
    border-color: var(--highlight);
    color: var(--brand-ink);
  }
  .chip[aria-pressed='true'] span {
    color: var(--brand-ink);
  }
  .group.is-in {
    animation: group-in 0.45s var(--ease-out);
  }
  @keyframes group-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .headline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    /* Four across, two by two, or one column: never three and an orphan. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .headline__item {
    border: 1px solid var(--rule);
    border-top: 2px solid var(--highlight);
    border-radius: var(--r-card);
    padding: 1.6rem 1.4rem;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    /* Badge, text and link sit on the centre line of each card. */
    align-items: center;
    text-align: center;
  }
  .headline__badge {
    transition: translate 0.3s var(--ease-out);
    width: 104px;
    height: 104px;
    object-fit: contain;
    margin-bottom: 1.1rem;
  }
  .headline__item:hover .headline__badge {
    translate: 0 -3px;
  }
  .headline__issuer {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .headline__name {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }
  .headline__dates {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }
  .headline__item .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
  }

  .group + .group {
    margin-top: 2.75rem;
  }
  .group__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    padding: 0 1px 1px 0;
  }
  /* Each tile carries its own border, overlapped by a pixel, so a part-empty
     last row is simply empty rather than a filled block. */
  .badges__item {
    background: var(--bg);
    border: 1px solid var(--rule);
    margin: 0 -1px -1px 0;
  }
  .badges__item a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.1rem 1.1rem;
    text-decoration: none;
    height: 100%;
  }
  .badges__item a {
    transition: background-color 0.25s ease;
  }
  .badges__item a:hover {
    background: var(--surface);
  }
  .badges__art :global(img) {
    transition: translate 0.3s var(--ease-out);
  }
  .badges__item a:hover .badges__art :global(img) {
    translate: 0 -4px;
  }
  .badges__art {
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .badges__art :global(img) {
    max-height: 112px;
    max-width: 112px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .badges__art--cert :global(img) {
    max-width: 100%;
    border: 1px solid var(--rule);
  }
  .badges__placeholder {
    width: 96px;
    height: 96px;
    display: grid;
    place-items: center;
    border: 1px solid var(--highlight);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--highlight);
  }
  .badges__name {
    font-size: 0.9rem;
    line-height: 1.4;
    flex: 1 1 auto;
  }
  .badges__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .badges__date {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .badges__verify {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  @media (min-width: 1100px) {
    .headline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .headline {
      grid-template-columns: minmax(0, 1fr);
    }
    .badges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .badges__item a {
      padding: 1rem 0.8rem;
    }
    .badges__art {
      height: 88px;
    }
    .badges__art :global(img) {
      max-height: 88px;
      max-width: 88px;
    }
    .badges__art--cert :global(img) {
      max-width: 100%;
    }
    .badges__placeholder {
      width: 76px;
      height: 76px;
    }
    .badges__meta {
      flex-wrap: wrap;
    }
  }
</style>

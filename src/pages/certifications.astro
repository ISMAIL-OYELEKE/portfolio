---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import SocialIcon from '../components/SocialIcon.astro';
import { headlineCerts, badgeGroups, certCount } from '../data/certifications';

const description = `All ${certCount} of Ismail Oyeleke's certifications and badges, including AWS Certified Solutions Architect Associate and KCNA, each linking to the issuer for verification.`;
---

<Base title="Certifications" description={description}>
  <PageHero
    eyebrow="Certifications"
    title={`${certCount} certifications and badges, all verifiable`}
    lede="Every badge links to its issuer, so you can check any of them in one click."
  />

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Professional certifications</span>
        <h2>The four that count</h2>
        <span class="rule-gold"></span>
      </div>

      <ul class="headline">
        {
          headlineCerts.map((c) => (
            <li class="headline__item lift reveal">
              {c.image && (
                <Image
                  class="headline__badge"
                  src={c.image}
                  alt={`${c.name} badge`}
                  width={104}
                  height={104}
                  densities={[1, 2]}
                  format="webp"
                />
              )}
              <p class="headline__issuer">{c.issuer}</p>
              <h3 class="headline__name">{c.name}</h3>
              <p class="headline__dates">
                {c.issued && <span>Issued {c.issued}</span>}
                {c.expires && <span>Valid to {c.expires}</span>}
              </p>
              <a class="text-link" href={c.verify} target="_blank" rel="noopener">
                Verify with issuer
                <SocialIcon name="external" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="on-dark section">
    <div class="shell">
      <div class="section-head">
        <span class="eyebrow">Training</span>
        <h2>Course and training badges</h2>
        <p class="lede">Grouped by issuer. Each badge links to its own verification page.</p>
        <span class="rule-gold"></span>
      </div>

      {
        badgeGroups.map((group) => (
          <section class="group">
            <h3 class="group__title">{group.issuer}</h3>
            <ul class="badges">
              {group.badges.map((b) => (
                <li class="badges__item">
                  <a href={b.verify} target="_blank" rel="noopener">
                    <span class:list={['badges__art', b.imageShape === 'certificate' && 'badges__art--cert']}>
                      {b.image ? (
                        <Image
                          src={b.image}
                          alt={`${b.name} ${b.imageShape === 'certificate' ? 'certificate' : 'badge'}`}
                          width={b.imageShape === 'certificate' ? 220 : 112}
                          densities={[1, 2]}
                          format="webp"
                          loading="lazy"
                        />
                      ) : (
                        <span class="badges__placeholder" aria-hidden="true">
                          {group.issuer.split(' ')[0]}
                        </span>
                      )}
                    </span>
                    <span class="badges__name">{b.name}</span>
                    <span class="badges__meta">
                      {b.issued && <span class="badges__date">{b.issued}</span>}
                      <span class="badges__verify">
                        Verify
                        <SocialIcon name="external" size={12} />
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .headline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    /* Four across, two by two, or one column: never three and an orphan. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .headline__item {
    border: 1px solid var(--rule);
    border-top: 2px solid var(--gold);
    border-radius: var(--r-card);
    padding: 1.6rem 1.4rem;
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .headline__badge {
    transition: translate 0.3s var(--ease-out);
    width: 104px;
    height: 104px;
    object-fit: contain;
    margin-bottom: 1.1rem;
  }
  .headline__item:hover .headline__badge {
    translate: 0 -3px;
  }
  .headline__issuer {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .headline__name {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }
  .headline__dates {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }
  .headline__item .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    align-self: flex-start;
  }

  .group + .group {
    margin-top: 2.75rem;
  }
  .group__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    padding: 0 1px 1px 0;
  }
  /* Each tile carries its own border, overlapped by a pixel, so a part-empty
     last row is simply empty rather than a filled block. */
  .badges__item {
    background: var(--bg);
    border: 1px solid var(--rule);
    margin: 0 -1px -1px 0;
  }
  .badges__item a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.1rem 1.1rem;
    text-decoration: none;
    height: 100%;
  }
  .badges__item a {
    transition: background-color 0.25s ease;
  }
  .badges__item a:hover {
    background: var(--surface);
  }
  .badges__art :global(img) {
    transition: translate 0.3s var(--ease-out);
  }
  .badges__item a:hover .badges__art :global(img) {
    translate: 0 -4px;
  }
  .badges__art {
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .badges__art :global(img) {
    max-height: 112px;
    max-width: 112px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .badges__art--cert :global(img) {
    max-width: 100%;
    border: 1px solid var(--rule);
  }
  .badges__placeholder {
    width: 96px;
    height: 96px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .badges__name {
    font-size: 0.9rem;
    line-height: 1.4;
    flex: 1 1 auto;
  }
  .badges__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .badges__date {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .badges__verify {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  @media (min-width: 1100px) {
    .headline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .headline {
      grid-template-columns: minmax(0, 1fr);
    }
    .badges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .badges__item a {
      padding: 1rem 0.8rem;
    }
    .badges__art {
      height: 88px;
    }
    .badges__art :global(img) {
      max-height: 88px;
      max-width: 88px;
    }
    .badges__art--cert :global(img) {
      max-width: 100%;
    }
    .badges__placeholder {
      width: 76px;
      height: 76px;
    }
    .badges__meta {
      flex-wrap: wrap;
    }
  }
</style>

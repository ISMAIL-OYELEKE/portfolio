---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, socials } from '../data/site';
import { brandStyle } from '../lib/brands';

const description =
  'Get in touch with Ismail Oyeleke, Cloud and DevOps Engineer in Lagos, Nigeria, about a role, a freelance project or an architecture review.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Ismail Oyeleke',
  url: new URL('/contact', Astro.site).href,
};
---

<Base title="Contact" description={description} hideStickyCta schema={schema}>
  <section class="contact">
    <div class="shell">
      <!-- Styled like a service health page: every way to reach me is a row. -->
      <header class="status-head">
        <div>
          <span class="eyebrow">Contact · Service health</span>
          <h1>Every channel is up. Pick one.</h1>
          <p class="lede">
            I read every message and reply, usually within a day. If it is about a role, say which one and I
            will send whatever else you need.
          </p>
        </div>
        <span class="pill pill--ok"><i></i>All channels operational</span>
      </header>

      <div class="contact__grid">
        <div class="status">
          <ul class="status__rows">
            <li>
              <span class="status__name">Email</span>
              <span class="status__what">
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <button type="button" class="copy" data-copy={site.email} hidden>Copy</button>
                <small>Best for roles and documents. Replies within a day.</small>
              </span>
              <span class="pill pill--ok"><i></i>Operational</span>
            </li>
            <li>
              <span class="status__name">WhatsApp</span>
              <span class="status__what">
                <a href={site.whatsapp} target="_blank" rel="noopener">Open a chat</a>
                <small>Quickest way to set up a call.</small>
              </span>
              <span class="pill pill--ok"><i></i>Operational</span>
            </li>
            <li>
              <span class="status__name">Phone</span>
              <span class="status__what">
                <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
                <small>Calls on West Africa Time, UTC+1.</small>
              </span>
              <span class="pill pill--ok"><i></i>Operational</span>
            </li>
            <li>
              <span class="status__name">LinkedIn</span>
              <span class="status__what">
                <a href={socials[0].href} target="_blank" rel="me noopener">Connect and message</a>
                <small>For introductions and referrals.</small>
              </span>
              <span class="pill pill--ok"><i></i>Operational</span>
            </li>
            <li>
              <span class="status__name">Lagos time</span>
              <span class="status__what">
                <b data-lagos-time>West Africa Time, UTC+1</b>
                <small>{site.locality}, {site.region}, {site.country}</small>
              </span>
              <span class="pill pill--time" data-lagos-part hidden></span>
            </li>
          </ul>

          <dl class="status__open">
            <dt>Open to</dt>
            <dd>{site.openTo}</dd>
          </dl>

          <ul class="contact__socials" aria-label="Elsewhere">
            {
              socials.slice(1).map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="me noopener" style={brandStyle(s.icon)}>
                    <SocialIcon name={s.icon} size={16} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="contact__form">
          <h2 class="contact__form-title">Or send a message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // The live time in Lagos, so visitors can see whether it is day or night here.
  const timeEl = document.querySelector<HTMLElement>('[data-lagos-time]');
  const partEl = document.querySelector<HTMLElement>('[data-lagos-part]');
  const tick = () => {
    const now = new Date();
    const time = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
    const hour = Number(now.toLocaleString('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Africa/Lagos' }));
    const day = hour >= 7 && hour < 22;
    if (timeEl) timeEl.textContent = `${time} in Lagos (WAT)`;
    if (partEl) {
      partEl.hidden = false;
      partEl.textContent = day ? 'Daytime' : 'Night-time';
      partEl.classList.toggle('pill--ok', day);
    }
  };
  tick();
  setInterval(tick, 30000);

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      window.setTimeout(() => (btn.textContent = 'Copy'), 1800);
    });
  });
</script>

<style>
  .contact {
    --ok: #2b7d4f;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  :global(:root[data-theme='dark']) .contact {
    --ok: #5cc58a;
  }
  :global(:root[data-theme='dark']) .contact__socials a :global(.brand-icon) {
    color: var(--brand-on-dark);
  }
  .status-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .status-head h1 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    margin: 0.4rem 0 0.6rem;
  }
  .status-head .lede {
    margin: 0;
    max-width: 40rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.6rem;
    border: 1px solid currentColor;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .pill--ok {
    color: var(--ok);
  }
  .pill--time {
    color: var(--accent);
  }
  .pill[hidden] {
    display: none;
  }

  .contact__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
  }
  .status__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .status__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 0.4rem 1rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .status__name {
    font-weight: 600;
  }
  .status__what {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .status__what small {
    flex-basis: 100%;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .status__what a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .status__what a:hover {
    border-bottom-color: var(--accent);
  }
  .status__what b {
    font-family: var(--font-mono);
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .status__rows li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .status__what {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .status__open {
    margin: 1.5rem 0 0;
  }
  .status__open dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }
  .status__open dd {
    margin: 0;
    max-width: 44ch;
  }

  .copy {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--accent);
  }
  .copy[hidden] {
    display: none;
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .contact__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-sharp);
    font-size: 0.85rem;
    color: var(--text);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  .contact__socials a :global(.brand-icon) {
    color: var(--brand);
    transition: color 0.2s ease;
  }
  .contact__socials a:hover,
  .contact__socials a:focus-visible {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    transform: translateY(-2px);
  }
  .contact__socials a:hover :global(.brand-icon),
  .contact__socials a:focus-visible :global(.brand-icon) {
    color: #fff;
  }

  .contact__form {
    min-width: 0;
    overflow-wrap: anywhere;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--highlight);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
  }
  .contact__form-title {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

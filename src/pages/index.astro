---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import CloudHero from '../components/CloudHero.astro';
import ServiceSky from '../components/ServiceSky.astro';
import ReleaseHistory from '../components/ReleaseHistory.astro';
import CertDeck from '../components/CertDeck.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, stats } from '../data/site';
import { cloudProjects, freelanceProjects } from '../data/projects';
import { certCount } from '../data/certifications';

const description =
  'Ismail Oyeleke is an AWS Certified Solutions Architect and Cloud/DevOps Engineer in Lagos, Nigeria, building secure, automated AWS infrastructure and production software.';
---

<Base title={`${site.name}, Cloud and DevOps Engineer in Lagos`} description={description}>
  <CloudHero />

  <!-- Hello -->
  <section class="section hello">
    <div class="shell">
      <div class="hello__grid">
        <div class="hello__portrait reveal">
          <Portrait alt={`${site.name}, ${site.role}`} width={340} smallWidth={150} />
        </div>
        <div class="hello__copy reveal">
          {
            site.availableForWork && (
              <p class="availability">
                <span class="availability__dot" aria-hidden="true"></span>
                Available for cloud and DevOps roles
              </p>
            )
          }
          <h2>
            {site.headline} <span class="hello__sub">{site.headlineSub}</span>
          </h2>
          <p class="lede">{site.subheadline}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={site.cv} download>
              <SocialIcon name="download" size={15} />
              Download CV
            </a>
            <a class="btn btn--ghost" href="/about">
              More about me
              <SocialIcon name="arrow" size={15} />
            </a>
          </div>
        </div>
      </div>

      <dl class="stats">
        {
          stats.map((s) => (
            <div class="stats__item">
              <dt>{s.label}</dt>
              <dd data-count={/^\d+/.test(s.value) ? s.value : undefined}>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Cloud work: the service sky -->
  <section class="on-dark section">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Projects · Deployed to production</span>
        <h2>Pick a project. Watch its architecture light up.</h2>
        <p class="lede">
          Every AWS service I have shipped with, in one sky. Point at a project to see what it runs
          on, open it for the full case study, or drag the services around.
        </p>
      </div>
      <ServiceSky projects={cloudProjects} />
      <div class="btn-row btn-row--center">
        <a class="btn btn--ghost" href="/projects">
          All projects
          <SocialIcon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Experience as a release history -->
  <section class="section">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Experience · Release history</span>
        <h2>Every version of me shipped something.</h2>
        <p class="lede">From keeping an airport's network up to running loan platforms on AWS.</p>
      </div>
      <ReleaseHistory />
      <div class="btn-row btn-row--center">
        <a class="btn btn--ghost" href="/experience">
          Full experience
          <SocialIcon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Certifications as a deck -->
  <section class="section section--sunken">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Verified</span>
        <p class="deck-count" data-count={String(certCount)}>{certCount}</p>
        <h2>certifications and badges, and still counting.</h2>
        <p class="lede">They start as one deck. Deal them out, then flip any card to verify it.</p>
      </div>
      <CertDeck />
      <div class="btn-row btn-row--center">
        <a class="btn btn--ghost" href="/certifications">
          All {certCount} certifications
          <SocialIcon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Freelance teaser -->
  <section class="section">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Freelance software</span>
        <h2>Systems businesses run on</h2>
        <p class="lede">
          Beyond infrastructure, I build and maintain production software for clients in Lagos.
        </p>
      </div>

      <div class="grid grid--pair">
        {freelanceProjects.map((p) => <ProjectCard project={p} />)}
      </div>

      <div class="btn-row btn-row--center">
        <a class="btn btn--ghost" href="/freelance">
          Freelance work
          <SocialIcon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="on-dark section closing">
    <div class="shell">
      <div class="section-head section-head--center">
        <span class="eyebrow">Next step</span>
        <h2>Ship me a message.</h2>
        <p class="lede">
          Hiring for cloud, DevOps or AWS architecture? Tell me about the role or the system you
          need built. I reply to every message, and I am open to {site.openTo}.
        </p>
      </div>
      <div class="btn-row btn-row--center">
        <a class="btn btn--primary" href="/contact">
          Start a conversation
          <SocialIcon name="arrow" size={15} />
        </a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>
          <SocialIcon name="mail" size={15} />
          Email directly
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // The two numbers in the stats row count up once when they come into view.
  // The real value is in the HTML from the start; this only animates it.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (counters.length && !still && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const final = el.dataset.count ?? '';
      const target = parseInt(final, 10);
      const suffix = final.replace(/^\d+/, '');
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 1100, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${Math.round(target * eased)}${t === 1 ? suffix : ''}`;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.6 }
    );
    counters.forEach((el) => io.observe(el));
  }
</script>

<style>
  .section-head--center {
    margin-inline: auto;
    text-align: center;
  }
  .section-head--center .lede {
    margin-inline: auto;
  }
  .btn-row--center {
    justify-content: center;
  }

  .hello__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 62rem;
    margin-inline: auto;
  }
  .hello__portrait {
    display: flex;
    justify-content: center;
  }
  .hello h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.1;
  }
  .hello__sub {
    display: block;
    margin-top: 0.35em;
    font-size: 0.62em;
    line-height: 1.25;
    font-weight: 500;
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .hello__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hello .lede {
      margin-inline: auto;
    }
    .hello .btn-row {
      justify-content: center;
    }
    .hello__portrait :global(.portrait) {
      --portrait-w: 150px;
      aspect-ratio: 1;
    }
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    padding: 0.4rem 0.9rem;
    margin: 0 0 1.3rem;
  }
  .availability__dot {
    width: 7px;
    height: 7px;
    background: var(--highlight);
    border-radius: 50%;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    max-width: 62rem;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .stats__item {
    background: var(--bg);
    padding: 1.2rem;
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .stats dd {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    color: var(--accent);
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .deck-count {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent);
    margin: 0 auto 0.5rem;
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { roles, education } from '../data/experience';
import { site } from '../data/site';

const description =
  'The roles behind the work: cloud and DevOps engineering at an AWS Partner, backend development at KGE Technologies, and IT support at Nigeria\u2019s airports authority.';
---

<Base title="Experience" description={description}>
  <PageHero
    eyebrow="Experience"
    title="Roles, and what shipped in them"
    lede="Three roles, in cloud engineering, backend development and IT support, with what I actually did in each one."
  />

  <section class="section">
    <div class="shell">
      <ol class="timeline">
        {
          roles.map((role) => (
            <li class="timeline__item reveal">
              <div class="timeline__aside">
                <p class="timeline__period">{role.period}</p>
                <p class="timeline__mode">{role.mode}</p>
              </div>

              <div class="timeline__body">
                <h2 class="timeline__title">{role.title}</h2>
                <p class="timeline__company">
                  {role.companyUrl ? (
                    <a href={role.companyUrl} target="_blank" rel="noopener">
                      {role.company}
                      <SocialIcon name="external" size={12} />
                    </a>
                  ) : (
                    role.company
                  )}
                </p>
                <p class="timeline__line">{role.companyLine}</p>

                <h3 class="timeline__heading">What I did</h3>
                <ul class="timeline__list">
                  {role.did.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>

                {role.shipped && (
                  <>
                    <h3 class="timeline__heading">What shipped</h3>
                    <ul class="timeline__list">
                      {role.shipped.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </>
                )}

                <h3 class="timeline__heading">Tools</h3>
                <ul class="tag-row">
                  {role.tools.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="on-dark section">
    <div class="shell education">
      <div>
        <span class="eyebrow">Education</span>
        <h2>{education.degree}</h2>
        <p class="lede">
          {education.school}. {education.result}. Graduated {education.graduated}.
        </p>
        <p class="education__research">Final-year research: {education.research}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact">
          Get in touch
          <SocialIcon name="arrow" size={15} />
        </a>
        <a class="btn btn--ghost" href={site.cv} download>
          <SocialIcon name="download" size={15} />
          Download CV
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 1rem 2.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .timeline__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .timeline__period {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .timeline__mode {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .timeline__title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 0.3rem;
  }
  .timeline__company {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .timeline__company a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .timeline__company a:hover {
    border-bottom-color: var(--accent);
  }
  .timeline__line {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .timeline__heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.6rem 0 0.7rem;
  }

  .timeline__list {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .timeline__list li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--text-muted);
    max-width: 70ch;
  }
  /* An amber hairline rather than a checkmark bullet. */
  .timeline__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.75rem;
    height: 1px;
    background: var(--highlight);
  }

  .education {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, auto);
    gap: 1.5rem 3rem;
    align-items: center;
  }
  .education .btn-row {
    margin-top: 0;
  }
  .education__research {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 860px) {
    .timeline__item,
    .education {
      grid-template-columns: 1fr;
    }
  }
</style>

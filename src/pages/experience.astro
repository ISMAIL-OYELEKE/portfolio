---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { roles, education } from '../data/experience';
import { site } from '../data/site';

// Months in each role, counted inclusively from the dates in the data.
const months = (a: string, b: string) => {
  const [ay, am] = a.split('-').map(Number);
  const [by, bm] = b.split('-').map(Number);
  return (by - ay) * 12 + (bm - am) + 1;
};
const allTools = [...new Set(roles.flatMap((r) => r.tools))];

const description =
  'The roles behind the work: cloud and DevOps engineering at an AWS Partner, backend development at KGE Technologies, and IT support at Nigeria\u2019s airports authority.';
---

<Base title="Experience" description={description}>
  <PageHero
    eyebrow="Experience"
    title="Roles, and what shipped in them"
    lede="Three roles, in cloud engineering, backend development and IT support, with what I actually did in each one."
  />

  <section class="section">
    <div class="shell">
      <div class="router" data-router hidden>
        <p class="router__label">
          Route by tool. Pick one to see where I used it.
          <span class="router__out" data-router-out aria-live="polite"></span>
        </p>
        <div class="router__chips" role="group" aria-label="Filter roles by tool">
          {
            allTools.map((t) => (
              <button type="button" class="chip" aria-pressed="false" data-tool={t}>
                {t}
              </button>
            ))
          }
        </div>
      </div>

      <div class="timeline-wrap" data-timeline>
      <span class="timeline__rail" aria-hidden="true"><span data-rail-fill></span></span>
      <ol class="timeline">
        {
          roles.map((role) => (
            <li class="timeline__item reveal" data-tools={role.tools.join('|')}>
              <span class="timeline__dot" aria-hidden="true" />
              <div class="timeline__aside">
                <p class="timeline__period">{role.period}</p>
                <p class="timeline__mode">{role.mode}</p>
                <p class="uptime">
                  <b data-months={months(role.startISO, role.endISO)}>{months(role.startISO, role.endISO)}</b>
                  <span>months in the role</span>
                </p>
              </div>

              <div class="timeline__body">
                <h2 class="timeline__title">{role.title}</h2>
                <p class="timeline__company">
                  {role.companyUrl ? (
                    <a href={role.companyUrl} target="_blank" rel="noopener">
                      {role.company}
                      <SocialIcon name="external" size={12} />
                    </a>
                  ) : (
                    role.company
                  )}
                </p>
                <p class="timeline__line">{role.companyLine}</p>

                <h3 class="timeline__heading">What I did</h3>
                <ul class="timeline__list">
                  {role.did.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>

                {role.shipped && (
                  <>
                    <h3 class="timeline__heading">What shipped</h3>
                    <ul class="timeline__list">
                      {role.shipped.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </>
                )}

                <h3 class="timeline__heading">Tools</h3>
                <ul class="tag-row">
                  {role.tools.map((t) => (
                    <li class="tag" data-tag={t}>
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
      </div>
    </div>
  </section>

  <section class="on-dark section">
    <div class="shell education">
      <div>
        <span class="eyebrow">Education</span>
        <h2>{education.degree}</h2>
        <p class="lede">
          {education.school}. {education.result}. Graduated {education.graduated}.
        </p>
        <p class="education__research">Final-year research: {education.research}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact">
          Get in touch
          <SocialIcon name="arrow" size={15} />
        </a>
        <a class="btn btn--ghost" href={site.cv} download>
          <SocialIcon name="download" size={15} />
          Download CV
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Tool router: pick a tool, the roles that used it stay lit. */
  const router = document.querySelector<HTMLElement>('[data-router]');
  const items = [...document.querySelectorAll<HTMLElement>('.timeline__item')];
  if (router) {
    router.hidden = false;
    const out = router.querySelector<HTMLElement>('[data-router-out]')!;
    const chips = [...router.querySelectorAll<HTMLButtonElement>('[data-tool]')];
    let active: string | null = null;
    const apply = () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tool === active)));
      let hits = 0;
      items.forEach((it) => {
        const on = !active || it.dataset.tools!.split('|').includes(active);
        if (on && active) hits += 1;
        it.classList.toggle('is-dim', !on);
        it.querySelectorAll<HTMLElement>('[data-tag]').forEach((t) => t.classList.toggle('is-hit', t.dataset.tag === active));
      });
      out.textContent = active ? `${active}: ${hits} of ${items.length} roles` : '';
    };
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        active = active === c.dataset.tool ? null : c.dataset.tool!;
        apply();
        const first = items.find((it) => !it.classList.contains('is-dim'));
        if (active && first && first.getBoundingClientRect().top > window.innerHeight) {
          first.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        }
      }),
    );
  }

  /* Rail fills as you read; each role counts its months up as it arrives. */
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline && !reduce) {
    const fill = timeline.querySelector<HTMLElement>('[data-rail-fill]')!;
    timeline.classList.add('is-live');
    const update = () => {
      const r = timeline.getBoundingClientRect();
      const line = window.innerHeight * 0.6;
      fill.style.height = `${Math.min(Math.max(line - r.top, 0), r.height)}px`;
      items.forEach((it) => it.classList.toggle('is-on', it.getBoundingClientRect().top < line));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          const b = e.target as HTMLElement;
          const to = Number(b.dataset.months);
          const start = performance.now();
          const step = (t: number) => {
            const k = Math.min(1, (t - start) / 900);
            b.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(step);
          };
          b.textContent = '0';
          requestAnimationFrame(step);
        }),
      { threshold: 1 },
    );
    timeline.querySelectorAll('[data-months]').forEach((b) => io.observe(b));
  }
</script>

<style>
  .timeline-wrap {
    position: relative;
    padding-left: 2.5rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__rail {
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--rule);
  }
  .timeline__rail span {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: var(--highlight);
  }
  .timeline-wrap.is-live .timeline__rail span {
    height: 0;
  }
  .timeline__item {
    position: relative;
    transition: opacity 0.35s ease, filter 0.35s ease;
  }
  .timeline__item.is-dim {
    opacity: 0.28;
    filter: grayscale(1);
  }
  .timeline__dot {
    position: absolute;
    left: -2.5rem;
    top: clamp(2rem, 4vw, 3rem);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--highlight);
    transition: background-color 0.3s ease;
  }
  .timeline__item:first-child .timeline__dot {
    top: 0;
  }
  .timeline-wrap:not(.is-live) .timeline__dot,
  .timeline__item.is-on .timeline__dot {
    background: var(--highlight);
  }
  .uptime {
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .uptime b {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--text);
  }
  .uptime span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    max-width: 8rem;
  }
  .router {
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .router[hidden] {
    display: none;
  }
  .router__label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .router__out {
    display: block;
    margin-top: 0.35rem;
    color: var(--accent);
    min-height: 1.2em;
  }
  .router__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    max-width: 60rem;
    margin: 0 auto;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.4rem 0.7rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s var(--ease-out);
  }
  .chip:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .chip[aria-pressed='true'] {
    background: var(--highlight);
    border-color: var(--highlight);
    color: var(--brand-ink);
  }
  .tag.is-hit {
    background: var(--highlight);
    color: var(--brand-ink);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 1rem 2.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .timeline__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .timeline__period {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .timeline__mode {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .timeline__title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 0.3rem;
  }
  .timeline__company {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .timeline__company a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .timeline__company a:hover {
    border-bottom-color: var(--accent);
  }
  .timeline__line {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .timeline__heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.6rem 0 0.7rem;
  }

  .timeline__list {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .timeline__list li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--text-muted);
    max-width: 70ch;
  }
  /* An amber hairline rather than a checkmark bullet. */
  .timeline__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.75rem;
    height: 1px;
    background: var(--highlight);
  }

  .education {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .education .lede,
  .education__research {
    margin-inline: auto;
  }
  .education .btn-row {
    margin-top: 0;
    justify-content: center;
  }
  .education__research {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 860px) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
